{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SVM batch-settlement PaymentRequirements",
  "description": "Preflight acceptance contract; cross-field, u64, public-key, chain-state and signature verification remain runtime requirements. Not a live service advertisement.",
  "type": "object",
  "required": [
    "scheme",
    "network",
    "amount",
    "asset",
    "payTo",
    "maxTimeoutSeconds",
    "extra"
  ],
  "properties": {
    "scheme": {
      "const": "batch-settlement"
    },
    "network": {
      "const": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
    },
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Decimal u64 atomic units; runtime checks u64 bounds."
    },
    "asset": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "payTo": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "maxTimeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "extra": {
      "type": "object",
      "required": [
        "feePayer",
        "receiverAuthorizer",
        "withdrawDelay",
        "tokenProgram"
      ],
      "properties": {
        "paymentFlow": {
          "const": "authorization"
        },
        "feePayer": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "receiverAuthorizer": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "voucherSigner": {
          "enum": [
            "client",
            "server"
          ]
        },
        "operator": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "withdrawDelay": {
          "type": "integer",
          "minimum": 900,
          "maximum": 2592000
        },
        "tokenProgram": {
          "enum": [
            "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA",
            "TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb"
          ]
        },
        "memo": {
          "type": "string",
          "description": "Maximum 256 UTF-8 bytes, enforced by runtime."
        },
        "minDeposit": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maxIdleSecs": {
          "type": "integer",
          "minimum": 1
        },
        "recentBlockhash": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "recentSlot": {
          "type": "integer",
          "minimum": 0
        },
        "channelState": {
          "type": "object"
        },
        "voucherState": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "voucherSigner"
            ],
            "properties": {
              "voucherSigner": {
                "const": "server"
              }
            }
          },
          "then": {
            "required": [
              "operator"
            ]
          },
          "else": {
            "not": {
              "required": [
                "operator"
              ]
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
