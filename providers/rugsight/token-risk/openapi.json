{
    "openapi": "3.1.0",
    "info": {
        "title": "Rugsight API",
        "version": "1.3.0",
        "description": "Automated risk scores for Solana tokens. Free basic score; full report pay-per-call over x402 (0.03 USDC on Solana) or 1 USDC via Solana Pay for humans. Not financial advice.",
        "contact": {
            "name": "Rugsight",
            "url": "https://rugsight.rugsight.workers.dev",
            "email": "yunare-qwerng+rugsight@mail.grokbot.com"
        },
        "x-guidance": "Use GET /api/score/{mint} (free) for a quick verdict. Use GET /api/v1/report?mint={mint} (0.03 USDC via x402 on Solana mainnet) for the full report with holder breakdown, market metrics and explained flags. An unpaid call returns 402 with a PAYMENT-REQUIRED header; pay with any x402 client and retry. The alias /api/v1/report/{mint} behaves the same. MCP: https://rugsight.rugsight.workers.dev/mcp."
    },
    "servers": [
        {
            "url": "https://rugsight.rugsight.workers.dev"
        }
    ],
    "x-discovery": {
        "wellKnown": "https://rugsight.rugsight.workers.dev/.well-known/x402",
        "mcp": "https://rugsight.rugsight.workers.dev/mcp",
        "llms": "https://rugsight.rugsight.workers.dev/llms.txt"
    },
    "paths": {
        "/api/score/{mint}": {
            "get": {
                "operationId": "getTokenRiskScore",
                "summary": "Get a basic risk score and grade for a Solana token",
                "description": "Free basic risk score for a Solana token: 0-100 score, A-F grade (or IC for allowlisted issuer-controlled assets), verdict and risk flag codes.",
                "parameters": [
                    {
                        "name": "mint",
                        "in": "path",
                        "required": true,
                        "description": "Solana token mint address (base58)",
                        "schema": {
                            "type": "string",
                            "description": "Solana token mint address (base58)",
                            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                        },
                        "example": "DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263"
                    }
                ],
                "security": [],
                "responses": {
                    "200": {
                        "description": "Basic score",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "mint": {
                                            "type": "string"
                                        },
                                        "score": {
                                            "type": "integer"
                                        },
                                        "grade": {
                                            "type": "string",
                                            "enum": [
                                                "A",
                                                "B",
                                                "C",
                                                "D",
                                                "F",
                                                "IC"
                                            ]
                                        },
                                        "technicalGrade": {
                                            "type": "string",
                                            "enum": [
                                                "A",
                                                "B",
                                                "C",
                                                "D",
                                                "F"
                                            ]
                                        },
                                        "issuerControlled": {
                                            "type": "boolean"
                                        },
                                        "issuer": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "properties": {
                                                "name": {
                                                    "type": "string"
                                                },
                                                "assetType": {
                                                    "type": "string",
                                                    "enum": [
                                                        "stablecoin",
                                                        "tokenized-stock",
                                                        "wrapped-asset"
                                                    ]
                                                },
                                                "source": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "verdict": {
                                            "type": "string"
                                        },
                                        "confidence": {
                                            "type": "string",
                                            "enum": [
                                                "full",
                                                "partial"
                                            ]
                                        },
                                        "flags": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "code": {
                                                        "type": "string"
                                                    },
                                                    "severity": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "checkedAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    },
                                    "required": [
                                        "mint",
                                        "score",
                                        "grade"
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid mint"
                    }
                }
            }
        },
        "/api/v1/report": {
            "get": {
                "operationId": "getTokenRiskReport",
                "summary": "Fetch the full Solana token risk report (0.03 USDC, x402)",
                "description": "Rugsight full risk report for a Solana SPL / Token-2022 token: mint & freeze authority, Token-2022 extensions, top-20 holder breakdown (wallets vs pools/programs/burn), liquidity, 24h volume, pool age, every risk flag explained, 0-100 score and A-F grade (or IC = issuer-controlled for allowlisted regulated assets such as USDC, PYUSD, cbBTC or xStocks).",
                "parameters": [
                    {
                        "name": "mint",
                        "in": "query",
                        "required": true,
                        "description": "Solana token mint address (base58)",
                        "schema": {
                            "type": "string",
                            "description": "Solana token mint address (base58)",
                            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                        },
                        "example": "DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263"
                    }
                ],
                "x-payment-info": {
