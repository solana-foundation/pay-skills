              "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "price": "$0.25",
              "amount": "250000",
              "maxAmountRequired": "250000",
              "maxTimeoutSeconds": 60,
              "extra": {
                "name": "USD Coin",
                "version": "2"
              }
            },
            {
              "scheme": "exact",
              "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
              "asset": "USDC",
              "price": "$0.25",
              "amount": "250000",
              "maxAmountRequired": "250000",
