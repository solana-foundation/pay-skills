  "servers": [
    {
      "url": "https://pjm-nowcast-production.up.railway.app"
    }
  ],
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "disclaimer": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "NowcastEnvelope": {
        "type": "object",
        "description": "Descriptive statistics envelope. Fields asOf, polledAt, ageSeconds, maxAgeSeconds, stale are always present.",
        "properties": {
          "product": {
            "type": "string"
          },
          "disclaimer": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "polledAt": {
            "type": "string",
            "format": "date-time"
          },
          "ageSeconds": {
            "type": "integer"
          },
          "maxAgeSeconds": {
            "type": "integer"
          },
          "stale": {
            "type": "boolean"
          },
          "observationCount": {
            "type": "integer"
          },
          "rtoLmp": {
            "type": "object"
          },
          "zonalSpread": {
            "type": "object"
          },
          "rtoLoad": {
            "type": "object"
          },
          "price_vol": {
            "type": [
              "number",
              "null"
            ],
            "description": "Latest only. Rolling realized LMP std in $/MWh from the last 8 SQLite RTO LMP prints (RMS of successive diffs; not annualized Black vol, not rtoLmp.std). Null when price_vol_missing is true."
          },
          "price_vol_missing": {
            "type": "boolean"
          },
          "mix_std_price": {
            "type": [
              "number",
              "null"
            ],
            "description": "Latest only. Mixture std of RTO LMP in $/MWh from the poller mix.json sidecar. Not price_vol and not rtoLmp.std."
          },
          "mix_n_obs": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Latest only. Observation count paired with mix_std_price."
          },
          "windowHours": {
            "type": "integer"
          },
          "resolution": {
            "type": "string"
          },
          "priorPeriod": {
            "type": "object"
          }
        }
      },
      "LatestRequest": {
        "properties": {
          "families": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "rto_lmp",
                    "zonal_spread",
                    "rto_load"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Subset of rto_lmp, zonal_spread, rto_load. Default: all.",
            "title": "Families"
          }
        },
        "title": "LatestRequest",
        "type": "object"
      },
      "HistoryRequest": {
        "properties": {
          "families": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "rto_lmp",
                    "zonal_spread",
                    "rto_load"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Subset of rto_lmp, zonal_spread, rto_load. Default: all.",
            "title": "Families"
          },
          "windowHours": {
            "default": 24,
            "description": "Trailing window in hours. L2 maximum is 72.",
            "maximum": 72,
            "minimum": 1,
            "title": "Windowhours",
            "type": "integer"
          }
        },
        "title": "HistoryRequest",
        "type": "object"
      },
      "ExtendedHistoryRequest": {
        "properties": {
          "families": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "rto_lmp",
                    "zonal_spread",
                    "rto_load"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Subset of rto_lmp, zonal_spread, rto_load. Default: all.",
            "title": "Families"
          },
          "windowHours": {
            "default": 168,
            "description": "Trailing window in hours, capped by MAX_HISTORY_DAYS.",
            "minimum": 1,
            "title": "Windowhours",
            "type": "integer"
          },
          "resolution": {
            "default": "native",
            "description": "native = one point per poll; hourly = mean per clock hour.",
            "enum": [
              "native",
              "hourly"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "compare": {
            "default": "none",
            "description": "If prior_period, include the equal-length window immediately before.",
            "enum": [
              "none",
              "prior_period"
            ],
            "title": "Compare",
            "type": "string"
          }
        },
        "title": "ExtendedHistoryRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "x402 payment proof. Omit on free routes. On paid routes, missing or invalid payment yields HTTP 402 and a PAYMENT-REQUIRED header."
      }
    },
    "headers": {
      "PaymentRequired": {
        "description": "Base64-encoded x402 v2 payment requirements.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "PaymentRequired": {
        "description": "Payment required. Empty or malformed bodies without payment also receive 402 (not 400). Decode the PAYMENT-REQUIRED header.",
        "headers": {
          "PAYMENT-REQUIRED": {
            "$ref": "#/components/headers/PaymentRequired"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "Typically an empty object; terms are in the header."
            }
          }
        }
      },
      "DataUnavailable": {
        "description": "No observation is stored yet.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorBody"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "x402": []
    }
  ]
}
