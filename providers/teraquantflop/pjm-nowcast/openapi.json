          },
          "503": {
            "$ref": "#/components/responses/DataUnavailable"
          },
          "400": {
            "description": "Paid request with invalid window or body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "x402": []
          }
        ],
        "description": "1\u201372 hour descriptive history at native poll resolution. Not a forecast. Unpaid requests receive 402 with a PAYMENT-REQUIRED header. Descriptive statistics only. Not a forecast, signal, or trading recommendation. Aggregated from public market sources. Freshness depends on the last successful background poll.",
        "x-payment-info": {
          "scheme": "exact",
          "asset": "USDC",
          "price": "$0.10",
          "facilitator": "https://facilitator.payai.network",
          "networks": [
            "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
            "eip155:8453"
          ],
          "resource": {
            "url": "https://pjm-nowcast-production.up.railway.app/v1/nowcast/history",
            "description": "1\u201372h descriptive history of RTO LMP, zonal spreads, and RTO load."
          },
          "accepts": [
            {
              "scheme": "exact",
              "network": "eip155:8453",
              "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "price": "$0.10",
              "amount": "100000",
              "maxAmountRequired": "100000",
              "maxTimeoutSeconds": 60,
              "extra": {
                "name": "USD Coin",
                "version": "2"
              }
            },
            {
              "scheme": "exact",
              "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
              "asset": "USDC",
              "price": "$0.10",
              "amount": "100000",
              "maxAmountRequired": "100000",
              "maxTimeoutSeconds": 60
            }
          ]
        },
        "requestBody": {
