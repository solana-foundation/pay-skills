{
  "openapi": "3.1.0",
  "info": {
    "title": "ApeGuard \u2014 Solana Token Risk Intelligence",
    "description": "Real-time Solana memecoin risk scanner. Analyze token safety, whale activity, and buy recommendations. Powered by RugCheck, DEXScreener, OKX, and Jupiter.",
    "version": "1.0.0",
    "contact": {
      "name": "ApeGuard",
      "url": "https://github.com/cryptoeights/apeguard"
    }
  },
  "servers": [
    {
      "url": "https://apeguard.up.railway.app",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/scan": {
      "post": {
        "operationId": "scanToken",
        "summary": "Scan a Solana token for risks",
        "description": "Full risk analysis of a Solana token. Returns risk score (0-100), verdict (CLEAN/WATCH/RISKY/DANGER), 7 risk factors, red/green flags, and narrative summary.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "description": "Solana token mint address (base58, 32-44 chars)",
                    "example": "7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scan result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid address"
          },
          "500": {
            "description": "Scan failed"
          }
        }
      }
    },
    "/api/whale": {
      "post": {
        "operationId": "analyzeWhale",
        "summary": "Analyze whale activity for a token",
        "description": "Detects whale accumulation, selling, net flow, and suspicious wallet movements. Uses OKX Web3 data + on-chain analysis.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tokenAddress"
                ],
                "properties": {
                  "tokenAddress": {
                    "type": "string",
                    "description": "Solana token mint address",
                    "example": "7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU"
                  },
                  "tokenSymbol": {
                    "type": "string",
                    "example": "BONK"
                  },
                  "liquidity": {
                    "type": "number",
                    "description": "Current liquidity in USD"
                  },
                  "marketCap": {
                    "type": "number",
                    "description": "Current market cap in USD"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Whale analysis result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhaleResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/feed": {
      "get": {
        "operationId": "getLiveFeed",
        "summary": "Get live token feed",
        "description": "Returns 25 live Solana tokens with market data, risk classification, and momentum scores. Tokens sourced from RugCheck new tokens + DEXScreener enrichment.",
        "responses": {
          "200": {
            "description": "Token feed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FeedToken"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ScanResult": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "CLEAN",
              "WATCH",
              "RISKY",
              "DANGER",
              "UNKNOWN"
            ]
          },
          "totalScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "redFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "greenFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "narrative": {
            "type": "object"
          },
          "factors": {
            "type": "array"
          }
        }
      },
      "WhaleResult": {
        "type": "object",
        "properties": {
          "tokenAddress": {
            "type": "string"
          },
          "whaleSignal": {
            "type": "string",
            "enum": [
              "accumulation",
              "selling",
              "mixed",
              "neutral",
              "unknown"
            ]
          },
          "whaleScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "type": "string"
          },
          "netWhaleFlowUsd": {
            "type": "number"
          },
          "whaleBuyVolumeUsd": {
            "type": "number"
          },
          "whaleSellVolumeUsd": {
            "type": "number"
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "FeedToken": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "marketCap": {
            "type": "number"
          },
          "liquidity": {
            "type": "number"
          },
          "volume5m": {
            "type": "number"
          },
          "priceChange": {
            "type": "number"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}