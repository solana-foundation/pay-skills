{
  "openapi": "3.1.0",
  "info": {
    "title": "TailTrace Aircraft Identity, History & Intelligence API",
    "version": "1.0.0",
    "description": "Evidence-first aircraft intelligence for autonomous agents. Resolve physical-aircraft identity, inspect registration history, and retrieve available regulatory, safety, maintenance, operator, capacity, and registered-base evidence with provenance, confidence, freshness, conflicts, and uncertainty preserved."
  },
  "servers": [{"url": "https://tailtrace-solana-x402-prod.simonwakelin.workers.dev", "description": "Production Solana x402 gateway"}],
  "tags": [{"name": "system", "description": "Service status"}, {"name": "aircraft", "description": "Evidence-backed aircraft intelligence"}],
  "paths": {
    "/health": {"get": {"operationId": "getHealth", "tags": ["system"], "summary": "Check gateway health", "responses": {"200": {"description": "Gateway health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}}},
    "/ready": {"get": {"operationId": "getReadiness", "tags": ["system"], "summary": "Check gateway readiness", "responses": {"200": {"description": "Gateway readiness", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadinessResponse"}}}}}}},
    "/v1/aircraft/{n_number}/identify": {
      "get": {
        "operationId": "identifyAircraft", "tags": ["aircraft"], "summary": "Resolve physical aircraft identity", "description": "Resolve an FAA N-number to available evidence-backed physical-aircraft identity and registration information. Provenance, confidence, freshness, and uncertainty remain explicit.",
        "parameters": [{"$ref": "#/components/parameters/NNumber"}, {"$ref": "#/components/parameters/AsOf"}],
        "responses": {"200": {"description": "Identity and registration evidence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IdentifyResponse"}}}}, "400": {"description": "Invalid N-number"}, "402": {"$ref": "#/components/responses/PaymentRequired"}, "502": {"description": "TailTrace backend unavailable"}},
        "x-x402": {"version": 2, "scheme": "exact", "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp", "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGkGZwyTDt1v", "price": "$0.15", "facilitator": "https://facilitator.payai.network", "payment_required_header": "PAYMENT-REQUIRED", "payment_signature_header": "PAYMENT-SIGNATURE", "payment_response_header": "PAYMENT-RESPONSE"}
      }
    },
    "/v1/aircraft/{n_number}/history": {
      "get": {
        "operationId": "getAircraftHistory", "tags": ["aircraft"], "summary": "Retrieve aircraft registration history", "description": "Return available registration and historical evidence for an FAA N-number, including unresolved tail history, identity conflicts, provenance, and source freshness where present.",
        "parameters": [{"$ref": "#/components/parameters/NNumber"}, {"$ref": "#/components/parameters/AsOf"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Limit"}],
        "responses": {"200": {"description": "Registration and historical evidence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HistoryResponse"}}}}, "400": {"description": "Invalid N-number or pagination"}, "402": {"$ref": "#/components/responses/PaymentRequired"}, "502": {"description": "TailTrace backend unavailable"}},
        "x-x402": {"version": 2, "scheme": "exact", "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp", "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGkGZwyTDt1v", "price": "$0.49", "facilitator": "https://facilitator.payai.network", "payment_required_header": "PAYMENT-REQUIRED", "payment_signature_header": "PAYMENT-SIGNATURE", "payment_response_header": "PAYMENT-RESPONSE"}
      }
    },
    "/v1/aircraft/{n_number}/intelligence": {
      "get": {
        "operationId": "getAircraftIntelligence", "tags": ["aircraft"], "summary": "Retrieve fuller aircraft intelligence", "description": "Return the fuller available evidence-based aircraft view, which can include registration history, safety, maintenance, regulatory, operator, capacity, and registered-base context. Availability remains source- and evidence-scoped; unsupported facts are not inferred.",
        "parameters": [{"$ref": "#/components/parameters/NNumber"}, {"$ref": "#/components/parameters/AsOf"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Limit"}],
        "responses": {"200": {"description": "Available aircraft intelligence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IntelligenceResponse"}}}}, "400": {"description": "Invalid N-number or pagination"}, "402": {"$ref": "#/components/responses/PaymentRequired"}, "502": {"description": "TailTrace backend unavailable"}},
        "x-x402": {"version": 2, "scheme": "exact", "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp", "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGkGZwyTDt1v", "price": "$0.99", "facilitator": "https://facilitator.payai.network", "payment_required_header": "PAYMENT-REQUIRED", "payment_signature_header": "PAYMENT-SIGNATURE", "payment_response_header": "PAYMENT-RESPONSE"}
      }
    }
  },
  "components": {
    "parameters": {
      "NNumber": {"name": "n_number", "in": "path", "required": true, "description": "FAA N-number, for example N10004.", "schema": {"type": "string", "pattern": "^N[0-9]{1,5}[A-HJ-NP-Z]{0,2}$"}},
      "AsOf": {"name": "as_of", "in": "query", "required": false, "description": "Optional evidence cutoff date.", "schema": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
      "Offset": {"name": "offset", "in": "query", "required": false, "description": "Optional zero-based page offset.", "schema": {"type": "integer", "minimum": 0}},
      "Limit": {"name": "limit", "in": "query", "required": false, "description": "Optional page size.", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}
    },
    "responses": {"PaymentRequired": {"description": "x402 V2 payment required; accepts Solana mainnet USDC through PayAI", "headers": {"PAYMENT-REQUIRED": {"description": "Payment challenge; retry with PAYMENT-SIGNATURE.", "schema": {"type": "string"}}}}},
    "schemas": {
      "HealthResponse": {"type": "object", "additionalProperties": true, "properties": {"status": {"type": "string"}, "service": {"type": "string"}, "network": {"type": "string"}}},
      "ReadinessResponse": {"type": "object", "additionalProperties": true, "properties": {"status": {"type": "string"}, "service": {"type": "string"}, "network": {"type": "string"}}},
      "AircraftIdentity": {"type": "object", "additionalProperties": true, "description": "Physical-aircraft identity when sufficiently resolved; absence is not a guess.", "properties": {"aircraft_id": {"type": "string"}, "manufacturer": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "series": {"type": ["string", "null"]}, "serial_number": {"type": ["string", "null"]}, "year_manufactured": {"type": ["integer", "null"]}, "faa_aircraft_code": {"type": ["string", "null"]}, "aircraft_type": {"type": ["string", "null"]}, "aircraft_category": {"type": ["string", "null"]}}},
      "IdentifyResponse": {"type": "object", "additionalProperties": true, "properties": {"requested_n_number": {"type": "string"}, "resolution_status": {"type": "string"}, "identity": {"$ref": "#/components/schemas/AircraftIdentity"}, "registration_evidence": {"type": "array", "items": {}}, "provenance": {"type": "array", "items": {}}, "source_freshness": {"type": "array", "items": {}}}},
      "HistoryResponse": {"type": "object", "additionalProperties": true, "properties": {"requested_n_number": {"type": "string"}, "identify": {"$ref": "#/components/schemas/IdentifyResponse"}, "registration_evidence": {"type": "array", "items": {}}, "ntsb_events": {"type": "array", "items": {}}, "aids_events": {"type": "array", "items": {}}, "unresolved_tail_history": {"type": "array", "items": {}}, "identity_conflicts": {"type": "array", "items": {}}, "provenance": {"type": "array", "items": {}}, "source_freshness": {"type": "array", "items": {}}, "pagination": {"type": "object", "additionalProperties": true}}},
      "IntelligenceResponse": {"type": "object", "additionalProperties": true, "properties": {"requested_n_number": {"type": "string"}, "identify": {"$ref": "#/components/schemas/IdentifyResponse"}, "registration_evidence": {"type": "array", "items": {}}, "ntsb_events": {"type": "array", "items": {}}, "aids_events": {"type": "array", "items": {}}, "sdr_events": {"type": "array", "items": {}}, "regulatory_records": {"type": "array", "items": {}}, "operator": {"type": ["object", "null"]}, "passenger_capacity": {"type": ["object", "null"]}, "registered_base": {"type": ["object", "null"]}, "provenance": {"type": "array", "items": {}}, "source_freshness": {"type": "array", "items": {}}, "pagination": {"type": "object", "additionalProperties": true}}}
    }
  }
}
