{
 "openapi": "3.1.0",
 "info": {
  "title": "Vigfox Solana gacha pack data (pay per call)",
  "version": "1.0.0",
  "description": "Live, minute by minute data on every public Solana gacha pack (Collector Crypt, Phygitals): return after buyback, published EV ratio, odds and stock per tier, where to buy. $0.01 USDC per call over x402 on Solana mainnet. No account or API key. Figures are averages, not promises.",
  "contact": {
   "name": "The Vigfox Team",
   "email": "hello@vigfox.xyz",
   "url": "https://vigfox.xyz/api/docs/"
  }
 },
 "servers": [
  {
   "url": "https://vigfox.xyz"
  }
 ],
 "components": {
  "securitySchemes": {
   "x402": {
    "type": "apiKey",
    "in": "header",
    "name": "PAYMENT-SIGNATURE",
    "description": "x402 v2 PaymentPayload, base64 JSON (legacy X-PAYMENT also accepted)."
   }
  }
 },
 "paths": {
  "/api/x402/best": {
   "get": {
    "operationId": "bestPacks",
    "summary": "List Solana gacha packs ranked by return after buyback",
    "description": "Top packs by return after buyback (cash back per dollar after the instant buyback), with odds, stock, rank vs the median and storefront links. $0.01 USDC per call.",
    "parameters": [
     {
      "name": "n",
      "in": "query",
      "description": "How many packs to return (1-10).",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 10,
       "default": 5
      }
     },
     {
      "name": "venue",
      "in": "query",
      "description": "Filter by venue: collector crypt or phygitals (substring match).",
      "schema": {
       "type": "string"
      },
      "example": "phygitals"
     },
     {
      "name": "category",
      "in": "query",
      "description": "Pack category as listed by the venue, e.g. Pokemon, Sports, One Piece.",
      "schema": {
       "type": "string"
      },
      "example": "Pokemon"
     },
     {
      "name": "max_price",
      "in": "query",
      "description": "Only packs priced at or below this many US dollars.",
      "schema": {
       "type": "number"
      },
      "example": 100
     }
    ],
    "x-payment-info": {
     "protocols": [
      "x402"
     ],
     "pricingMode": "fixed",
     "price": "0.01",
     "currency": "USDC",
     "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
     "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
     "payTo": "J69koR4o7aYrFH11U3BpkYywXasd4aMVXSk19pXbE92D"
    },
    "security": [
     {
      "x402": []
     }
    ],
    "responses": {
     "200": {
      "description": "Best packs",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "meta": {
           "type": "object"
          },
          "best": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "id": {
              "type": "string"
             },
             "slug": {
              "type": "string"
             },
             "name": {
              "type": "string"
             },
             "venue": {
              "type": "string"
             },
             "category": {
              "type": "string"
             },
             "price_usd": {
              "type": "number"
             },
             "return_after_buyback": {
              "type": "number",
              "description": "Average cash back after the instant buyback per $1 spent (0.92 = 92%). An average, not a promise."
             },
             "ev_ratio_published": {
              "type": "number"
             },
             "buyback_pct": {
              "type": "number"
             },
             "cards_left": {
              "type": "integer"
             },
             "tiers": {
              "type": "array",
              "items": {
               "type": "object",
               "properties": {
                "tier": {
                 "type": "string"
                },
                "odds": {
                 "type": "number"
                },
                "value_from": {
                 "type": "number"
                },
                "value_to": {
                 "type": "number"
                },
                "stock": {
                 "type": "integer"
                }
               }
              }
             },
             "where_to_buy": {
              "type": "array",
              "items": {
               "type": "object",
               "properties": {
                "storefront": {
                 "type": "string"
                },
                "url": {
                 "type": "string"
                }
               }
              }
             },
             "rank": {
              "type": "integer"
             },
             "of": {
              "type": "integer"
             },
             "beats_median": {
              "type": "boolean"
             },
             "last_change_at": {
              "type": "integer"
             },
             "quiet": {
              "type": "boolean"
             },
             "updated_at": {
              "type": "integer"
             }
            }
           }
          },
          "payment": {
           "type": "object"
          }
         }
        }
       }
      }
     },
     "402": {
      "description": "Payment Required. Body and base64 PAYMENT-REQUIRED header carry the x402 v2 PaymentRequired object (scheme exact, USDC on Solana mainnet)."
     },
     "503": {
      "description": "Warming up; nothing charged."
     }
    }
   }
  },
  "/api/x402/pack/{slug}": {
   "get": {
    "operationId": "packDetail",
    "summary": "Fetch one Solana gacha pack with odds, stock and rank",
    "description": "Odds and stock per tier, return after buyback, rank against all packs, storefront links. Slugs are listed free at /api/v1/packs. $0.01 USDC per call.",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "example": "pokemon-50"
     }
    ],
    "x-payment-info": {
     "protocols": [
      "x402"
     ],
     "pricingMode": "fixed",
     "price": "0.01",
     "currency": "USDC",
     "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
     "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
     "payTo": "J69koR4o7aYrFH11U3BpkYywXasd4aMVXSk19pXbE92D"
    },
    "security": [
     {
      "x402": []
     }
    ],
    "responses": {
     "200": {
      "description": "Pack",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "meta": {
           "type": "object"
          },
          "pack": {
           "type": "object",
           "properties": {
            "id": {
             "type": "string"
            },
            "slug": {
             "type": "string"
            },
            "name": {
             "type": "string"
            },
            "venue": {
             "type": "string"
            },
            "category": {
             "type": "string"
            },
            "price_usd": {
             "type": "number"
            },
            "return_after_buyback": {
             "type": "number",
             "description": "Average cash back after the instant buyback per $1 spent (0.92 = 92%). An average, not a promise."
            },
            "ev_ratio_published": {
             "type": "number"
            },
            "buyback_pct": {
             "type": "number"
            },
            "cards_left": {
             "type": "integer"
            },
            "tiers": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "tier": {
                "type": "string"
               },
               "odds": {
                "type": "number"
               },
               "value_from": {
                "type": "number"
               },
               "value_to": {
                "type": "number"
               },
               "stock": {
                "type": "integer"
               }
              }
             }
            },
            "where_to_buy": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "storefront": {
                "type": "string"
               },
               "url": {
                "type": "string"
               }
              }
             }
            },
            "rank": {
             "type": "integer"
            },
            "of": {
             "type": "integer"
            },
            "beats_median": {
             "type": "boolean"
            },
            "last_change_at": {
             "type": "integer"
            },
            "quiet": {
             "type": "boolean"
            },
            "updated_at": {
             "type": "integer"
            }
           }
          },
          "payment": {
           "type": "object"
          }
         }
        }
       }
      }
     },
     "402": {
      "description": "Payment Required. Body and base64 PAYMENT-REQUIRED header carry the x402 v2 PaymentRequired object (scheme exact, USDC on Solana mainnet)."
     },
     "404": {
      "description": "Unknown slug; nothing charged."
     }
    }
   }
  }
 }
}