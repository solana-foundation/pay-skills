{
  "openapi": "3.1.0",
  "info": {
    "title": "TVibe Signal",
    "version": "3.0.24",
    "description": "Free Solana mint risk gate for agents. Not financial advice."
  },
  "servers": [{"url": "https://signal-api-24q4.onrender.com"}],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "responses": {"200": {"description": "OK"}}
      }
    },
    "/omni": {
      "get": {
        "summary": "Primary risk gate",
        "operationId": "omni",
        "parameters": [
          {"name": "mint", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "view", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Risk payload"}}
      }
    },
    "/stats": {
      "get": {
        "summary": "Public track record",
        "operationId": "stats",
        "responses": {"200": {"description": "Stats"}}
      }
    },
    "/skill.json": {
      "get": {
        "summary": "Skill metadata",
        "operationId": "skill",
        "responses": {"200": {"description": "Skill JSON"}}
      }
    },
    "/ops/fair-use": {
      "get": {
        "summary": "Fair use policy",
        "operationId": "fair_use",
        "responses": {"200": {"description": "Policy"}}
      }
    },
    "/agent/playbook": {
      "get": {
        "summary": "Agent playbook",
        "operationId": "playbook",
        "responses": {"200": {"description": "Playbook"}}
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "Machine docs",
        "operationId": "llms",
        "responses": {"200": {"description": "Docs"}}
      }
    }
  }
}
