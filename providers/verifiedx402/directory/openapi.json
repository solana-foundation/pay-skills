{
  "openapi": "3.1.0",
  "info": {
    "title": "Verified x402",
    "version": "0.1.0",
    "summary": "Verified directory of paid x402 APIs.",
    "description": "Which x402 API to call? Verified x402 is a verified directory of paid x402 APIs. Check before paying: is this endpoint live and priced right? We continuously test listings, then rank verified matches for your task. Search is free. GET or POST /recommend returns a ranked shortlist of verified APIs for $0.005 USDC. This service does not call the recommended API for you.",
    "contact": {
      "name": "Verified x402",
      "email": "verifix402@mail.grokbot.com",
      "url": "https://verifiedx402.com"
    },
    "x-guidance": "To decide which x402 API to call, GET or POST /recommend (paid, x402 exact, $0.005 USDC) or use the MCP recommend tool. To check before paying whether an endpoint is live and priced right, use free GET /search?verified=1 or POST /check. Read PAYMENT-REQUIRED and retry with PAYMENT-SIGNATURE. For MCP, send payment in params._meta['x402/payment'] and read _meta['x402/payment-response']. This service does not call the recommended API.",
    "x-payment-info": {
      "x402Version": 2,
      "scheme": "exact",
      "price": "$0.005",
      "networks": [
        "eip155:8453",
        "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
      ],
      "payTo": {
        "eip155:8453": "0xd1bac498a13228df83708c6ab2ff47561c915cc3",
        "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp": "6Pt95picj6WLazjZqT6ofhPx5T7M6fD44HyuKqREmzQV"
      },
      "settlement": "cdp-facilitator"
    }
  },
  "servers": [
    {
      "url": "https://verifiedx402.com"
    }
  ],
  "security": [
    {
      "x402": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Fetch liveness and payment configuration.",
        "security": [],
        "responses": {
          "200": {
            "description": "Liveness and payment configuration."
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "search",
        "summary": "Search the catalog of x402 API listings.",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Keyword or phrase to search in listing titles and descriptions."
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional catalog category such as weather, extract, inference, search, onchain, data, or media."
          },
          {
            "name": "network",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional CAIP-2 network filter, for example eip155:8453 or solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp."
          },
          {
            "name": "max_price",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Maximum advertised price in USDC."
          },
          {
            "name": "verified",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Only listings verified in the last 72 hours."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "verified",
                "stale",
                "mismatch",
                "no_402",
                "down",
                "unchecked"
              ]
            },
            "description": "Optional listing status filter."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Page size. Default 20."
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Number of matching listings to skip. Default 0."
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog page, including unverified listings unless filtered."
          },
          "429": {
            "description": "Rate limit."
          }
        }
      }
    },
    "/recommend": {
      "get": {
        "operationId": "recommend",
        "summary": "Fetch a ranked shortlist of verified x402 APIs.",
        "description": "Ranks verified x402 listings for a task. Does not call the recommended API.",
        "parameters": [
          {
            "name": "task",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "What the agent needs done, for example 'current weather in Toronto' or 'text embeddings for a document'. Required. Used to decide which x402 API to call.",
            "example": "current weather in Toronto",
            "required": true
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional catalog category such as weather, extract, inference, search, onchain, data, or media."
          },
          {
            "name": "network",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional CAIP-2 network filter, for example eip155:8453 for Base."
          },
          {
            "name": "max_price",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Maximum advertised price in USDC."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5,
              "maximum": 10
            },
            "description": "How many listings to return. Default 5, maximum 10.",
            "example": 3
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked verified listings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                },
                "example": {
                  "query": {
                    "task": "current weather in Toronto",
                    "limit": 3
                  },
                  "payment": {
                    "price": "$0.005",
                    "network": "eip155:8453",
                    "payTo": "0xd1bac498a13228df83708c6ab2ff47561c915cc3",
                    "settlement": "cdp-facilitator"
                  },
                  "considered": 12,
                  "recommendations": [
                    {
                      "rank": 1,
                      "id": "example",
                      "url": "https://weather.example/forecast",
                      "description": "Hourly weather forecast for any city worldwide, including temperature and humidity.",
                      "category": "weather",
                      "network": "eip155:8453",
                      "scheme": "exact",
                      "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                      "payTo": "0x2222222222222222222222222222222222222222",
                      "httpMethod": "GET",
                      "price": {
                        "atomic": "1000",
                        "usd": 0.001
                      },
                      "relevance": 1,
                      "scores": {
                        "composite": 88,
                        "uptime": 100,
                        "priceHonesty": 100,
                        "responseValidity": 60,
                        "latency": 100,
                        "integrity": 100,
                        "integrityFlag": "none",
                        "samples": 4
                      },
                      "evidence": {
                        "probedAt": "2026-11-24T12:00:00.000Z",
                        "httpStatus": 402,
                        "latencyMs": 180,
                        "priceMatches": true,
                        "payToMatches": true,
                        "paidAttempted": false,
                        "paidResponseValid": null,
                        "error": null,
                        "integrityExplanation": "Bazaar reports recent calls from multiple payers."
                      }
                    }
                  ],
                  "methodology": "https://verifiedx402.com/methodology"
                }
              }
            }
          },
          "402": {
            "description": "Payment required. Read the PAYMENT-REQUIRED header (base64 JSON, x402 v2) and retry with PAYMENT-SIGNATURE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              }
            }
          }
        },
        "security": [
          {
            "x402": []
          }
        ]
      },
      "post": {
        "operationId": "recommendPost",
        "summary": "Search verified x402 APIs using a JSON task body.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
