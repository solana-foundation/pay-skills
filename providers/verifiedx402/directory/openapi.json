  "components": {
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "x402 v2 payment. After a 402, decode the PAYMENT-REQUIRED header and retry with PAYMENT-SIGNATURE. MCP tools/call recommend accepts the same payload in params._meta['x402/payment']."
      }
    },
