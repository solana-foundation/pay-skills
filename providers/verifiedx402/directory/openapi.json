    "/check": {
      "post": {
        "operationId": "checkEndpoint",
        "summary": "Check a URL against a live 402 challenge.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Public HTTP URL to probe for a live x402 payment challenge."
                  }
                }
              },
              "example": {
                "url": "https://verifiedx402.com/recommend"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result."
          },
          "400": {
            "description": "URL rejected."
          }
        },
        "security": []
      }
    }
