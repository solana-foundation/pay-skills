{
  "openapi": "3.1.0",
  "info": {
    "title": "GenTech Labs \u2014 market-intel",
    "version": "6.1.0"
  },
  "servers": [
    {
      "url": "https://gentech-x402-gateway.jordanjones0902.workers.dev"
    }
  ],
  "paths": {
    "/api/intel/search": {
      "get": {
        "operationId": "api_intel_search",
        "summary": "Multi-chain market intelligence search across 40+ exchanges",
        "tags": [
          "market"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Product or title to search for across all categories"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["games", "movies", "all"] },
            "description": "Category to search within"
          }
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005000"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "networks": [
            "eip155:8453",
            "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
            "eip155:43114",
            "eip155:56",
            "eip155:196",
            "algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8="
          ]
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required \u2014 USDC on Base, Solana, Avalanche, BNB, or OKX"
          }
        }
      }
    },
    "/api/intel/cheapest": {
      "get": {
        "operationId": "api_intel_cheapest",
        "summary": "Cheapest across all categories",
        "tags": [
          "intel"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Product or title to find the cheapest option for"
          }
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005000"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "networks": [
            "eip155:8453",
            "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
            "eip155:43114",
            "eip155:56",
            "eip155:196",
            "algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8="
          ]
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required — USDC on Base, Solana, Avalanche, BNB, or OKX"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "x-payment-info": {
          "price": {
            "mode": "free"
          }
        }
      }
    },
    "/pricing": {
      "get": {
        "summary": "Pricing list",
        "operationId": "pricing",
        "x-payment-info": {
          "price": {
            "mode": "free"
          }
        }
      }
    }
  }
}