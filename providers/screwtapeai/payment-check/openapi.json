{
  "openapi": "3.1.0",
  "info": {
    "title": "Screwtape Payment Check",
    "version": "1.4.0",
    "description": "Payment check: is this seller safe to pay? allow, review or block with a signed receipt. $0.005 USDC per call.",
    "contact": {
      "email": "support@screwtape.ai",
      "url": "https://screwtape.ai"
    }
  },
  "servers": [
    {
      "url": "https://screwtape.ai"
    }
  ],
  "paths": {
    "/v1/payment-check": {
      "post": {
        "operationId": "paymentCheck",
        "summary": "Check whether a seller is safe to pay",
        "description": "Payment check: is this seller safe to pay, checked at the moment the agent pays. Compares the 402 price and payee with the seller's published listings when they can be fetched, screens the payee against a local denylist and the bundled OFAC SDN crypto-address list, flags an over-price versus the intended amount, reuses the duplicate-payment check, and confirms the seller URL returns a valid 402. Returns allow, review or block with reasons and a signed receipt id. Fetches time out in about 2s and fail closed to review. $0.005 USDC per call.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "x402": []
          },
          {}
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "seller_url": {
                    "type": "string",
                    "description": "The seller's paid HTTP URL."
                  },
                  "payment_required": {
                    "description": "The seller's 402 PAYMENT-REQUIRED payload or base64 header value."
                  },
                  "intended_amount": {
                    "type": "number",
                    "description": "USD the agent intends to pay."
                  },
                  "agent_id": {
                    "type": "string",
                    "description": "Optional agent or caller id, also used on the signed receipt."
                  },
                  "event_id": {
                    "type": "string",
                    "description": "Optional idempotency key for this check."
                  }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "seller_url": "https://seller.example/pay",
                    "intended_amount": 0.005,
                    "agent_id": "agent-001"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "allow, review or block with reasons and a signed receipt id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verdict": {
                      "type": "string",
                      "description": "allow, review, or block."
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "receipt_id": {
                      "type": "string"
                    },
                    "verify_url": {
                      "type": "string"
                    },
                    "payee": {
                      "type": "string"
                    },
                    "amount_usd": {
                      "type": "number"
                    },
                    "checks": {
                      "type": "object"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "402": {
            "description": "Payment required; PAYMENT-REQUIRED contains x402 v2 requirements."
          }
        }
      }
    }
  }
}
