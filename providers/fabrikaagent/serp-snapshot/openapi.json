{
  "openapi": "3.1.0",
  "info": {
    "title": "serp-snapshot",
    "version": "1.0.0",
    "description": "Live search-engine results (top-10 organic, JSON). x402 pay-per-call, 0.02 USDC on Base."
  },
  "servers": [
    {
      "url": "https://x402-serp.shablony-pro.workers.dev"
    }
  ],
  "paths": {
    "/serp": {
      "get": {
        "operationId": "serp-snapshot",
        "summary": "Top-10 organic SERP results as JSON",
        "description": "Runs a live web search (Bing) and returns top organic results: title, url, snippet. No API keys required by the caller. Requires x402 payment: 0.02 USDC on Base.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of results (max 10)"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON array of results",
            "content": {
              "application/json": {}
            }
          },
          "402": {
            "description": "x402 payment challenge"
          },
          "400": {
            "description": "Missing query parameter"
          }
        }
      }
    }
  }
}