{
  "openapi": "3.1.0",
  "info": {
    "title": "serp-snapshot",
    "version": "1.0.0",
    "description": "Live search-engine results (top-10 organic, JSON). x402 pay-per-call, 0.02 USDC on Base."
  },
  "servers": [
    {
      "url": "https://x402-serp.shablony-pro.workers.dev"
    }
  ],
  "paths": {
    "/serp": {
      "get": {
        "operationId": "serp-snapshot",
        "summary": "Top-10 organic SERP results as JSON",
        "description": "Runs a live web search (Bing) and returns top organic results: title, url, snippet. No API keys required by the caller. Requires x402 payment: 0.02 USDC on Base. Unpaid request returns HTTP 402 with accepts[]; retry with X-PAYMENT header.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 5,
              "maximum": 10
            },
            "description": "Number of results (5-10, default 10)"
          }
        ],
        "responses": {
          "200": {
            "description": "SERP snapshot as JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "fetched_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "source": {
                      "type": "string",
                      "example": "bing-html"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "position": {
                            "type": "integer"
                          },
                          "title": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "snippet": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "position",
                          "title",
                          "url"
                        ]
                      }
                    },
                    "error": {
                      "type": "string",
                      "description": "Present only if the upstream fetch failed after payment verification (call is not settled/charged)"
                    }
                  },
                  "required": [
                    "query",
                    "count",
                    "fetched_at",
                    "source",
                    "results"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid q parameter",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "x402 payment challenge (accepts[] carries payment requirements)",
            "content": {
              "application/json": {}
            }
          },
          "502": {
            "description": "Upstream search fetch failed; payment is NOT settled for failed calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}