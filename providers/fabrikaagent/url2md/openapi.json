{
  "openapi": "3.1.0",
  "info": {
    "title": "url2md",
    "version": "1.0.0",
    "description": "URL to clean Markdown conversion. x402 pay-per-call, 0.01 USDC on Base."
  },
  "servers": [
    {
      "url": "https://x402-url2md.shablony-pro.workers.dev"
    }
  ],
  "paths": {
    "/md": {
      "get": {
        "operationId": "url2md",
        "summary": "Convert URL to Markdown",
        "description": "Fetches a public URL and returns clean Markdown (title, headings, links, tables preserved). Requires x402 payment: 0.01 USDC on Base. Unpaid request returns HTTP 402 with accepts[]; retry with X-PAYMENT header.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Public http(s) URL to convert"
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown of the page",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string",
                  "description": "Clean Markdown of the fetched page (title, headings, links, tables preserved)"
                }
              }
            }
          },
          "400": {
            "description": "Missing/invalid url parameter (not charged)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "x402 payment challenge (accepts[] carries payment requirements)",
            "content": {
              "application/json": {}
            }
          },
          "502": {
            "description": "Upstream fetch failed (timeout, unhandleable content-type, or >2MB page). Payment is NOT settled for failed calls.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}