{
  "openapi": "3.1.0",
  "info": {
    "title": "emailval",
    "version": "1.0.0",
    "description": "Email validation (syntax, MX, disposable check). x402 pay-per-call, 0.003 USDC on Base."
  },
  "servers": [
    {
      "url": "https://x402-emailval.shablony-pro.workers.dev"
    }
  ],
  "paths": {
    "/validate": {
      "get": {
        "operationId": "emailval",
        "summary": "Validate one email address",
        "description": "Checks syntax, MX records via DNS-over-HTTPS, and disposable-domain list. Returns JSON verdict. Requires x402 payment: 0.003 USDC on Base. Unpaid request returns HTTP 402 with accepts[]; retry with X-PAYMENT header.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON validation verdict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string"
                    },
                    "valid_syntax": {
                      "type": "boolean"
                    },
                    "domain": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "mx_found": {
                      "type": "boolean"
                    },
                    "mx": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Up to 5 MX records"
                    },
                    "disposable": {
                      "type": "boolean"
                    },
                    "has_a_record": {
                      "type": "boolean"
                    },
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "deliverable_likely",
                        "risky",
                        "disposable",
                        "invalid"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "description": "Machine-readable reason code: syntax | no_mx_no_a | no_mx_but_a_record | disposable_domain | syntax+mx_ok"
                    }
                  },
                  "required": [
                    "email",
                    "valid_syntax",
                    "domain",
                    "mx_found",
                    "mx",
                    "disposable",
                    "has_a_record",
                    "verdict",
                    "reason"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing/invalid email parameter (not charged)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "x402 payment challenge (accepts[] carries payment requirements)",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  }
}