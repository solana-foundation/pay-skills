{
  "openapi": "3.1.0",
  "info": {
    "title": "emailval",
    "version": "1.0.0",
    "description": "Email validation (syntax, MX, disposable check). x402 pay-per-call, 0.003 USDC on Base."
  },
  "servers": [
    {
      "url": "https://x402-emailval.shablony-pro.workers.dev"
    }
  ],
  "paths": {
    "/validate": {
      "get": {
        "operationId": "emailval",
        "summary": "Validate one email address",
        "description": "Checks syntax, MX records via DNS-over-HTTPS, and disposable-domain list. Returns JSON verdict. Requires x402 payment: 0.003 USDC on Base.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON validation verdict",
            "content": {
              "application/json": {}
            }
          },
          "402": {
            "description": "x402 payment challenge"
          },
          "400": {
            "description": "Missing/invalid email parameter"
          }
        }
      }
    }
  }
}