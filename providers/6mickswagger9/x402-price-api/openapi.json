{
  "openapi": "3.0.3",
  "info": {
    "title": "X402 Price API",
    "version": "1.0.0",
    "description": "Real-time crypto prices, gas fees, FX rates, and x402 endpoint pricing. Batch up to 10 coins."
  },
  "servers": [
    { "url": "https://x402-api-production-bd43.up.railway.app" }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Get service status and available endpoint list",
        "responses": { "200": { "description": "Service metadata" } }
      }
    },
    "/.well-known/agent.json": {
      "get": {
        "summary": "Get the agent capability manifest for this service",
        "responses": { "200": { "description": "Agent manifest" } }
      }
    },
    "/.well-known/x402": {
      "get": {
        "summary": "Get x402 payment config and supported token addresses",
        "responses": { "200": { "description": "Payment config" } }
      }
    },
    "/.well-known/x402.json": {
      "get": {
        "summary": "Get x402 JSON payment config with chain and token details",
        "responses": { "200": { "description": "Payment config" } }
      }
    },
    "/ath": {
      "get": {
        "summary": "Get the all-time high price for a crypto asset",
        "responses": { "200": { "description": "ATH data" } }
      }
    },
    "/domains": {
      "get": {
        "summary": "Get supported asset identifiers for price queries",
        "responses": { "200": { "description": "Domain list" } }
      }
    },
    "/dominance": {
      "get": {
        "summary": "Get market dominance percentages for major assets",
        "responses": { "200": { "description": "Dominance data" } }
      }
    },
    "/fear-greed": {
      "get": {
        "summary": "Get the Crypto Fear and Greed Index value",
        "responses": { "200": { "description": "Index value" } }
      }
    },
    "/fx": {
      "get": {
        "summary": "Get the exchange rate between two fiat currencies",
        "responses": { "200": { "description": "FX rate" } }
      }
    },
    "/gas": {
      "get": {
        "summary": "Get current gas price and transaction cost estimate",
        "responses": { "200": { "description": "Gas data" } }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "Get LLM-readable endpoint docs for this service",
        "responses": { "200": { "description": "Plain text docs" } }
      }
    },
    "/news": {
      "get": {
        "summary": "Get latest crypto news headlines with sentiment",
        "responses": { "200": { "description": "News list" } }
      }
    },
    "/price": {
      "get": {
        "summary": "Get current price, 24h change, and volume for assets",
        "responses": { "200": { "description": "Price data" } }
      }
    },
    "/price-history": {
      "get": {
        "summary": "Get historical price data for an asset over a range",
        "responses": { "200": { "description": "Price history" } }
      }
    },
    "/quote": {
      "get": {
        "summary": "Get a real-time bid and ask quote for a pair",
        "responses": { "200": { "description": "Quote data" } }
      }
    },
    "/route": {
      "get": {
        "summary": "Get the optimal swap route between two tokens",
        "responses": { "200": { "description": "Route info" } }
      }
    },
    "/session-check": {
      "get": {
        "summary": "Check the current x402 session budget and status",
        "responses": { "200": { "description": "Session status" } }
      }
    },
    "/sheet": {
      "get": {
        "summary": "Get a price sheet for up to 10 assets in one call",
        "responses": { "200": { "description": "Price sheet" } }
      }
    },
    "/split": {
      "get": {
        "summary": "Get the optimal multi-hop split for a large swap",
        "responses": { "200": { "description": "Split plan" } }
      }
    },
    "/weather": {
      "get": {
        "summary": "Get a market summary of current volatility and trend",
        "responses": { "200": { "description": "Market summary" } }
      }
    },
    "/yields": {
      "get": {
        "summary": "Get current DeFi yield rates for major protocols",
        "responses": { "200": { "description": "Yield data" } }
      }
    }
  }
}
