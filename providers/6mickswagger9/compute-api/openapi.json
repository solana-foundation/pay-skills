{
  "openapi": "3.0.3",
  "info": {
    "title": "Compute API",
    "version": "1.0.0",
    "description": "String manipulation, hashing, JSON validation, regex, encoding, and utility functions for AI agents."
  },
  "servers": [
    { "url": "https://compute-api-production-245d.up.railway.app" }
  ],
  "paths": {
    "/.well-known/agent.json": {
      "get": {
        "summary": "Get the agent capability manifest for this service",
        "responses": { "200": { "description": "Agent manifest" } }
      }
    },
    "/.well-known/x402": {
      "get": {
        "summary": "Get x402 payment config and supported token addresses",
        "responses": { "200": { "description": "Payment config" } }
      }
    },
    "/.well-known/x402.json": {
      "get": {
        "summary": "Get x402 JSON payment config with chain and token details",
        "responses": { "200": { "description": "Payment config" } }
      }
    },
    "/base64": {
      "post": {
        "summary": "Convert a string to or from base64 encoding",
        "responses": { "200": { "description": "Encoded result" } }
      }
    },
    "/capabilities": {
      "get": {
        "summary": "Get all supported compute operations and schemas",
        "responses": { "200": { "description": "Capabilities list" } }
      }
    },
    "/chain-status": {
      "get": {
        "summary": "Check status of a chained compute pipeline by job ID",
        "responses": { "200": { "description": "Pipeline status" } }
      }
    },
    "/constants": {
      "get": {
        "summary": "Get chain IDs, token addresses, and gas limit constants",
        "responses": { "200": { "description": "Constants" } }
      }
    },
    "/convert": {
      "post": {
        "summary": "Convert a value between units or data formats",
        "responses": { "200": { "description": "Converted value" } }
      }
    },
    "/diff": {
      "post": {
        "summary": "Generate a unified diff between two text inputs",
        "responses": { "200": { "description": "Diff output" } }
      }
    },
    "/hash": {
      "post": {
        "summary": "Generate a SHA-256 or Keccak-256 hash of input",
        "responses": { "200": { "description": "Hash digest" } }
      }
    },
    "/injection-check": {
      "post": {
        "summary": "Detect SQL, XSS, or prompt-injection patterns in text",
        "responses": { "200": { "description": "Injection findings" } }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "Get LLM-readable endpoint docs for this service",
        "responses": { "200": { "description": "Plain text docs" } }
      }
    },
    "/password-strength": {
      "post": {
        "summary": "Score password strength and return entropy estimate",
        "responses": { "200": { "description": "Strength score" } }
      }
    },
    "/regex": {
      "post": {
        "summary": "Search text for regex pattern matches and captures",
        "responses": { "200": { "description": "Match results" } }
      }
    },
    "/reverse": {
      "post": {
        "summary": "Transform a string by reversing its character order",
        "responses": { "200": { "description": "Reversed string" } }
      }
    },
    "/slugify": {
      "post": {
        "summary": "Convert a string to a URL-safe slug",
        "responses": { "200": { "description": "Slug output" } }
      }
    },
    "/string-stats": {
      "post": {
        "summary": "Determine character, word, line count, and entropy",
        "responses": { "200": { "description": "Statistics" } }
      }
    },
    "/timezone": {
      "post": {
        "summary": "Convert a timestamp between two timezones",
        "responses": { "200": { "description": "Converted timestamp" } }
      }
    },
    "/token-count": {
      "post": {
        "summary": "Determine BPE token count for a given string",
        "responses": { "200": { "description": "Token count" } }
      }
    },
    "/uuid": {
      "post": {
        "summary": "Generate a random UUID v4 identifier",
        "responses": { "200": { "description": "UUID value" } }
      }
    },
    "/validate-json": {
      "post": {
        "summary": "Validate JSON syntax and return any parse errors",
        "responses": { "200": { "description": "Validation result" } }
      }
    },
    "/version": {
      "get": {
        "summary": "Get the API version and supported operation count",
        "responses": { "200": { "description": "Version info" } }
      }
    }
  }
}
