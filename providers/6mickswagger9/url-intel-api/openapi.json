{
  "openapi": "3.0.3",
  "info": {
    "title": "URL Intel API",
    "version": "1.0.0",
    "description": "URL status, redirect chain, SSL expiry, page metadata, batch check, and service discovery."
  },
  "servers": [
    { "url": "https://url-intel-api-production.up.railway.app" }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Get service status and available endpoint list",
        "responses": { "200": { "description": "Service metadata" } }
      }
    },
    "/.well-known/agent.json": {
      "get": {
        "summary": "Get the agent capability manifest for this service",
        "responses": { "200": { "description": "Agent manifest" } }
      }
    },
    "/.well-known/x402": {
      "get": {
        "summary": "Get x402 payment config and supported token addresses",
        "responses": { "200": { "description": "Payment config" } }
      }
    },
    "/.well-known/x402.json": {
      "get": {
        "summary": "Get x402 JSON payment config with chain and token details",
        "responses": { "200": { "description": "Payment config" } }
      }
    },
    "/batch": {
      "post": {
        "summary": "Check up to 10 URLs in a single batch call",
        "responses": { "200": { "description": "Batch results" } }
      }
    },
    "/check": {
      "post": {
        "summary": "Check a URL for liveness, safety, and redirects",
        "responses": { "200": { "description": "Check result" } }
      }
    },
    "/find": {
      "get": {
        "summary": "Find URLs matching a pattern from the scan cache",
        "responses": { "200": { "description": "Matched URLs" } }
      }
    },
    "/health-report": {
      "get": {
        "summary": "Get an aggregate health report for monitored URLs",
        "responses": { "200": { "description": "Health report" } }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "Get LLM-readable endpoint docs for this service",
        "responses": { "200": { "description": "Plain text docs" } }
      }
    },
    "/manifest": {
      "get": {
        "summary": "Get the service manifest with endpoints and pricing",
        "responses": { "200": { "description": "Manifest" } }
      }
    },
    "/metadata": {
      "post": {
        "summary": "Fetch page metadata including title and OG tags",
        "responses": { "200": { "description": "Page metadata" } }
      }
    },
    "/redirects": {
      "post": {
        "summary": "Trace the full redirect chain for a URL",
        "responses": { "200": { "description": "Redirect chain" } }
      }
    },
    "/ssl": {
      "post": {
        "summary": "Check SSL certificate status and expiry date",
        "responses": { "200": { "description": "SSL status" } }
      }
    }
  }
}
