                "payTo": "Fx3ufwEQjfVRFhD9HGDVrEzRdkVsu6Hd8UnUDwC2nFMV"
              }
            }
          ]
        }
      }
    },
    "/x402/meta": {
      "get": {
        "summary": "Fetch web page metadata (OpenGraph, Twitter, icons, JSON-LD)",
        "description": "Fetch a public web page and return its metadata: title, description, canonical URL, language, OpenGraph and Twitter card tags, icons and parsed JSON-LD blocks.",
        "security": [],
