    "info": {
        "description": "Pay-per-call web page summarization and structured extraction for AI agents. Payment via x402 (exact scheme) in native USDC on Solana mainnet.",
        "title": "PageDigest — Web Page Summarizer & Structured Extractor",
        "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/summarize": {
            "post": {
                "description": "Fetch a web page URL and return a concise extractive summary with title, description, headings, key points, and structured entities.",
                "operationId": "summarizeUrl",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "example": {
                                "url": "https://example.com"
                            },
                            "schema": {
                                "$ref": "#/components/schemas/SummarizeRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Summary"
                                }
                            }
                        },
                        "description": "Summary and structured extraction for the requested page."
                    },
                    "400": {
                        "description": "Invalid arguments (missing or malformed URL, or maxSentences out of range). Returned before any payment is charged."
                    },
                    "402": {
                        "description": "Payment required. The response carries a PAYMENT-REQUIRED header with an x402 v2 exact-scheme challenge for native USDC on Solana mainnet."
                    }
                },
                "summary": "Summarize a web page and extract structured info",
                "x-payment-info": {
                    "price": {
                        "amount": "0.01",
                        "currency": "USD",
                        "mode": "fixed"
                    },
                    "protocols": [
                        {
                            "x402": {}
                        }
                    ]
                }
            }
        }
