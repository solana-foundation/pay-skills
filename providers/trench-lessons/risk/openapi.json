{
  "openapi": "3.1.0",
  "info": {
    "title": "Trench Lessons API",
    "version": "1.0.0",
    "description": "Solana meme coin research feed and pre-trade risk flags for trading bots, pay-per-request via x402 (USDC on Solana mainnet). Educational research only, not financial advice.",
    "x-guidance": "Two paid GET endpoints, no account needed; pay per call with x402 (USDC on Solana mainnet). 1) GET /api/signals/risk?mint=<mint> ($0.01), e.g. /api/signals/risk?mint=DFMt2FyLpB6ekPNAzVErLXgpSnJ9CRf1VnxBAkTLpump (equivalent path form: /api/signals/risk/<mint>); pass a real Solana SPL token mint address, never the literal placeholder (a missing/invalid/template mint returns 400 before any payment challenge or charge); free real sample: GET /api/signals/risk/sample; returns flags curveSkipPool, unlockedLp, mayhemMode, bundleHandoff, each with value (true/false/null), status (ok/unknown/n/a) and confidence, plus riskScore 0-100. Treat 'unknown' as no data, not as safe. 2) GET /api/lessons/feed?days=N ($0.005, N 1-30, default 7): structured JSON of the most recent daily research findings (topic, evidence grade, points, sources). Free (not listed here): GET /api/lessons/latest and GET /api/pricing. Payments are final; see /terms.",
    "termsOfService": "https://trench-lessons.vercel.app/terms",
    "contact": {
      "name": "Trench Lessons",
      "email": "jeragon775@gmail.com"
    }
  },
  "servers": [
    {
      "url": "https://trench-lessons.vercel.app"
    }
  ],
  "paths": {
    "/api/signals/risk": {
      "get": {
        "operationId": "getRiskFlagsByQuery",
        "summary": "Risk flags for a Solana meme coin mint",
        "description": "Read-only on-chain checks: curve-skip PumpSwap pool, unlocked LP, pump.fun Mayhem mode, bundle handoff. Example: /api/signals/risk?mint=DFMt2FyLpB6ekPNAzVErLXgpSnJ9CRf1VnxBAkTLpump (path form /api/signals/risk/{mint} is equivalent). Free real sample (no payment): /api/signals/risk/sample.",
        "externalDocs": {
          "description": "Free sample response",
          "url": "https://trench-lessons.vercel.app/api/signals/risk/sample"
        },
        "tags": [
          "Signals"
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.01"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "mint",
            "in": "query",
            "required": true,
            "description": "Solana SPL token mint address",
            "schema": {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            },
            "example": "DFMt2FyLpB6ekPNAzVErLXgpSnJ9CRf1VnxBAkTLpump"
          }
        ],
        "responses": {
          "200": {
            "description": "Risk report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mint": {
                      "type": "string"
                    },
                    "mocked": {
                      "type": "boolean"
                    },
                    "riskScore": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "scoredFlags": {
                      "type": "integer"
                    },
                    "flags": {
                      "type": "object",
                      "properties": {
                        "curveSkipPool": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "unknown",
                                "n/a"
                              ]
                            },
                            "confidence": {
                              "type": "string",
                              "enum": [
                                "high",
                                "medium",
                                "low"
                              ]
                            },
                            "detail": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "value",
                            "status"
                          ]
                        },
                        "unlockedLp": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "unknown",
                                "n/a"
                              ]
                            },
                            "confidence": {
                              "type": "string",
                              "enum": [
                                "high",
                                "medium",
                                "low"
                              ]
                            },
                            "detail": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "value",
                            "status"
                          ]
                        },
                        "mayhemMode": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "unknown",
                                "n/a"
                              ]
                            },
                            "confidence": {
                              "type": "string",
                              "enum": [
                                "high",
                                "medium",
                                "low"
                              ]
                            },
                            "detail": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "value",
                            "status"
                          ]
                        },
                        "bundleHandoff": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "unknown",
                                "n/a"
                              ]
                            },
                            "confidence": {
                              "type": "string",
                              "enum": [
                                "high",
                                "medium",
                                "low"
                              ]
                            },
                            "detail": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "value",
                            "status"
                          ]
                        }
                      }
                    },
                    "asOf": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "disclaimer": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "mint",
                    "flags",
                    "riskScore"
                  ]
                },
                "example": {
                  "mint": "DFMt2FyLpB6ekPNAzVErLXgpSnJ9CRf1VnxBAkTLpump",
                  "mocked": false,
                  "network": "solana-mainnet (read-only RPC)",
                  "flags": {
                    "curveSkipPool": {
                      "value": false,
                      "status": "ok",
                      "confidence": "high",
                      "detail": {
                        "pool": "Fk5MuGv2H3Qpt6AxdhS2KHgDL2os424BvfEoqFNTdv9Y",
                        "lookup": "canonical-pda"
                      }
                    },
                    "unlockedLp": {
                      "value": false,
                      "status": "ok",
                      "confidence": "high",
                      "detail": {
                        "note": "remaining LP is dust (effectively all burned)"
                      }
                    },
                    "mayhemMode": {
                      "value": false,
                      "status": "ok",
                      "confidence": "high",
                      "detail": {
                        "source": "bonding curve",
                        "curveComplete": true
                      }
                    },
                    "bundleHandoff": {
                      "value": false,
                      "status": "ok",
                      "confidence": "low",
                      "detail": {
                        "earlyNonDevBuyers": 4,
                        "walletsThatHandedOff": 0
                      }
                    }
                  },
                  "riskScore": 0,
                  "scoredFlags": 4,
                  "elapsedMs": 534,
                  "asOf": "2026-10-15T23:30:00.000Z",
                  "disclaimer": "Heuristic, read-only on-chain checks. Can be wrong. Not financial advice. Data as-is, no warranty. Terms: /terms"
                }
              }
            }
          },
          "400": {
            "description": "Missing, invalid or template-placeholder mint (rejected before payment; not charged)"
          },
          "402": {
            "description": "Payment Required"
          }
        }
      }
    },
