    "/api/lessons/feed": {
      "get": {
        "operationId": "getLessonsFeed",
        "summary": "Structured feed of daily Solana meme coin research findings",
        "tags": [
          "Lessons"
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.005"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Number of most recent daily lessons (1-30)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "generatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "disclaimer": {
                      "type": "string"
                    },
                    "feed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "format": "date"
                          },
                          "sources": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "findings": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "topic": {
                                  "type": "string"
                                },
                                "evidence": {
                                  "type": "string"
                                },
                                "points": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "feed"
                  ]
                },
                "example": {
                  "generatedAt": "2026-10-15T23:00:00.000Z",
                  "count": 1,
                  "feed": [
                    {
                      "date": "2026-10-15",
                      "findings": [
                        {
                          "topic": "LaunchTape: 2,193 pump.fun graduations, first 10 minutes",
                          "evidence": "A",
                          "points": [
                            "Dump clock: among 894 coins with a big-holder dump, median was 2.2 min after graduation; ~48% inside the first 2 min."
                          ]
                        }
                      ],
                      "sources": [
                        "https://dev.to/launchtape/what-2193-pumpfun-graduations-did-in-their-first-10-minutes-and-what-it-means-for-your-bot-4f70"
                      ]
                    }
                  ],
                  "disclaimer": "Educational research only. Not financial advice. Data as-is, no warranty. Terms: /terms"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required"
          }
        }
      }
