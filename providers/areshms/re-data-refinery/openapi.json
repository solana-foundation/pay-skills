        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.03"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Ohio city, e.g. Columbus (18 supported cities)"
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "USD price floor"
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "USD price ceiling"
          },
          {
            "name": "live",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "\"0\" forces the cache instead of a live RealtyAPI search"
          }
        ],
        "responses": {
          "200": {
            "description": "Scored city property list (source, city, count, properties[])",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "402": {
            "description": "Payment Required"
          }
        }
      }
    },
