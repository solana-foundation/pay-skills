{
  "openapi": "3.1.0",
  "info": {
    "title": "RE Data Refinery",
    "version": "1.0.0",
    "description": "Ohio property intelligence API for AI agents. x402 pay-per-call, USDC on Base (eip155:8453, permit2). 18 Ohio cities: scored property listings (flip/wholesale/rental scores), property detail by Zillow zpid, price + tax history, schools, foreclosure / tax-sale / auction / pre-foreclosure leads, and cash-buyer intelligence from county records. No accounts, no API keys; settle per call, JSON responses.",
    "x-guidance": "Pay-per-call x402 v2 (scheme exact, USDC on Base permit2, facilitator Coinbase CDP). An unpaid GET on any listed paid route returns HTTP 402 with a base64 JSON challenge in the PAYMENT-REQUIRED header; pay and replay with the x-payment header to receive 200 JSON plus a PAYMENT-RESPONSE settle receipt. Always verify dataset sizes first via the free /coverage endpoint. Example flow: GET /properties?city=Columbus ($0.03) to resolve a zpid, then GET /properties/{zpid} for scored detail. Foreclosure-family leads: /foreclosures, /tax-sales, /auctions, /preforeclosures ($0.05 each). /cash-buyers is tiered: zip=X costs $0.50 (rollup), parcel=X (digits-only Franklin County parcel) costs $2.50 (deed evidence). Rate limit 20 requests/min/IP. Free: /health, /coverage, /credits, /llms.txt, / and this /openapi.json.",
    "contact": {
      "name": "HMS LLC",
      "email": "ares.hms@icloud.com"
    }
  },
  "servers": [
    {
      "url": "https://re-data-refinery.ares-hms.workers.dev"
    }
  ],
  "tags": [
    {
      "name": "Property search"
    },
    {
      "name": "Property detail"
    },
    {
      "name": "History"
    },
    {
      "name": "Off-market leads"
    },
    {
      "name": "Cash buyers"
    },
    {
      "name": "Free"
    }
  ],
  "paths": {
    "/search": {
      "get": {
        "operationId": "searchProperties",
        "summary": "Search scored Ohio property listings by location",
        "tags": [
          "Property search"
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.05"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "City/state or ZIP, e.g. \"Columbus OH\" or \"43215\""
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "default": 20
            },
            "description": "Max results 1-40"
          }
        ],
        "responses": {
          "200": {
            "description": "Scored property list (query, count, provider, properties[])",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "402": {
            "description": "Payment Required"
          }
        }
      }
    },
    "/properties": {
      "get": {
        "operationId": "listProperties",
        "summary": "Fetch city-filtered scored property listings",
        "tags": [
          "Property search"
