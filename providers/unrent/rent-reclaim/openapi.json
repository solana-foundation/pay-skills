{
    "openapi": "3.1.0",
    "info": {
        "title": "UNRENT",
        "version": "1.0.0",
        "description": "Reclaim overpaid rent from Solana token accounts. SIMD-0437 lowers lamports_per_byte from 6,960 to 696 in five steps; existing accounts keep their old deposit until it is withdrawn. UNRENT scans wallets and builds unsigned reclaim transactions (WithdrawExcessLamports, CloseAccount) for the wallet to sign. Non-custodial. Scans are paid per request; reclaims carry UNRENT's service fee inside the transactions and cost nothing extra.",
        "contact": {
            "url": "https://unrent.xyz"
        }
    },
    "servers": [
        {
            "url": "https://unrent.xyz/api/v1"
        }
    ],
    "paths": {
        "/rent-status": {
            "get": {
                "operationId": "getRentStatus",
                "summary": "Fetch the Solana rent reduction status (SIMD-0437)",
                "description": "Live lamports_per_byte and the five SIMD-0437 steps with status and epoch. Free.",
                "responses": {
                    "200": {
                        "description": "Live lamports_per_byte, the five steps with status and epoch.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/scan": {
            "post": {
                "operationId": "scanWallet",
                "summary": "Fetch reclaimable Solana rent for a wallet",
                "description": "Excess rent, empty accounts and mint excess in SOL, the service fee, the net amount, a forecast per remaining step, dust that may be burned, and a signUrl for browser wallets.",
                "x-price-usd": "0.002",
                "x-payment-info": {
                    "offers": [
                        {
                            "amount": "2000",
                            "currency": "USDC",
                            "description": "0.002 USDC",
                            "intent": "charge",
                            "method": "mpp",
                            "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
                            "payTo": "9C2wveyrZgzjqPG38LpEi99KHtxBMdkpEKSpawGTPrpp",
                            "scheme": "charge"
                        },
                        {
                            "amount": "2000",
                            "currency": "USDC",
                            "description": "0.002 USDC",
                            "feePayer": "6Sy6sdWpeR84acmYAywKSyiAGZA2TTTo1h7vaNZmPpbR",
                            "intent": "charge",
                            "method": "x402",
                            "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
                            "payTo": "9C2wveyrZgzjqPG38LpEi99KHtxBMdkpEKSpawGTPrpp",
                            "scheme": "exact"
                        }
                    ]
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$schema": "https://json-schema.org/draft/2020-12/schema",
                                "type": "object",
                                "properties": {
                                    "wallet": {
                                        "type": "string",
                                        "description": "Solana wallet address (base58)."
                                    },
                                    "ref": {
                                        "description": "Optional UNRENT referral code. The referrer gets a share of the service fee; the wallet pays the same.",
                                        "type": "string",
                                        "maxLength": 32
                                    }
                                },
                                "required": [
                                    "wallet"
                                ]
                            },
                            "example": {
                                "wallet": "C569uDVow3rhCRT8GNp9xdzpU19rp6Deem4LQgCf89XZ"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reclaimable SOL, fee, net, forecast per remaining step, burn candidates and signUrl.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input: `{ error }`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Payment required (MPP or x402, USDC on Solana mainnet). Pay and repeat the request, e.g. with `pay curl`."
                    },
                    "429": {
                        "description": "Rate limited: `{ error }`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Busy: the scan queue is full. Try again shortly.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/portfolio": {
            "post": {
                "operationId": "scanPortfolio",
                "summary": "Fetch reclaimable rent for up to 25 wallets",
                "description": "Reclaimable, fee and net SOL per wallet and in total, in one request.",
                "x-price-usd": "0.02",
                "x-payment-info": {
                    "offers": [
                        {
                            "amount": "20000",
                            "currency": "USDC",
                            "description": "0.02 USDC",
                            "intent": "charge",
                            "method": "mpp",
                            "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
                            "payTo": "9C2wveyrZgzjqPG38LpEi99KHtxBMdkpEKSpawGTPrpp",
                            "scheme": "charge"
                        },
                        {
                            "amount": "20000",
                            "currency": "USDC",
                            "description": "0.02 USDC",
                            "feePayer": "6Sy6sdWpeR84acmYAywKSyiAGZA2TTTo1h7vaNZmPpbR",
                            "intent": "charge",
                            "method": "x402",
                            "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
                            "payTo": "9C2wveyrZgzjqPG38LpEi99KHtxBMdkpEKSpawGTPrpp",
                            "scheme": "exact"
                        }
                    ]
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$schema": "https://json-schema.org/draft/2020-12/schema",
                                "type": "object",
                                "properties": {
                                    "wallets": {
                                        "minItems": 1,
                                        "maxItems": 25,
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "description": "Solana wallet address (base58)."
                                        },
                                        "description": "Up to 25 Solana wallet addresses."
                                    }
                                },
                                "required": [
                                    "wallets"
                                ]
                            },
                            "example": {
                                "wallets": [
                                    "C569uDVow3rhCRT8GNp9xdzpU19rp6Deem4LQgCf89XZ"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reclaimable, fee and net SOL per wallet and in total.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input: `{ error }`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Payment required (MPP or x402, USDC on Solana mainnet). Pay and repeat the request, e.g. with `pay curl`."
                    },
                    "429": {
                        "description": "Rate limited: `{ error }`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Busy: the scan queue is full. Try again shortly.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/reclaim/build": {
            "post": {
                "operationId": "buildReclaim",
                "summary": "Create unsigned reclaim transactions",
                "description": "Unsigned, simulated transactions (base64) for the wallet to sign. Free: the service fee is the last instruction of each transaction. Sign every transaction unchanged and submit within about 60 seconds.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$schema": "https://json-schema.org/draft/2020-12/schema",
                                "type": "object",
                                "properties": {
                                    "wallet": {
                                        "type": "string",
                                        "description": "Solana wallet address (base58)."
                                    },
                                    "accounts": {
                                        "description": "Only these account addresses (from a scan). Default: everything reclaimable.",
                                        "maxItems": 2000,
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "burn": {
                                        "description": "Token accounts to burn and close (from the scan's burn.candidates). Only when the wallet owner explicitly asked for it.",
                                        "maxItems": 2000,
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "burnMaxUsd": {
                                        "description": "Highest USD value per account that may be burned (capped by burn.cleanupMaxUsd). Dust is burned regardless.",
                                        "type": "number",
                                        "minimum": 0,
                                        "maximum": 1000
                                    },
                                    "ref": {
                                        "description": "Optional UNRENT referral code. The referrer gets a share of the service fee; the wallet pays the same.",
                                        "type": "string",
                                        "maxLength": 32
                                    }
                                },
                                "required": [
                                    "wallet"
                                ]
                            },
                            "example": {
                                "wallet": "C569uDVow3rhCRT8GNp9xdzpU19rp6Deem4LQgCf89XZ"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "claimId, base64 transactions and a summary in SOL.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input: `{ error }`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nothing to reclaim.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limited: `{ error }`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Busy: the scan queue is full. Try again shortly.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/reclaim/submit": {
            "post": {
                "operationId": "submitReclaim",
                "summary": "Submit the signed reclaim transactions",
                "description": "Checks the signed transactions against the build and sends them to Solana. Free.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$schema": "https://json-schema.org/draft/2020-12/schema",
                                "type": "object",
                                "properties": {
                                    "claimId": {
                                        "type": "string",
                                        "minLength": 10,
                                        "maxLength": 32,
                                        "description": "claimId from the build."
                                    },
                                    "signed": {
                                        "minItems": 1,
                                        "maxItems": 100,
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "maxLength": 4000
                                        },
                                        "description": "The signed transactions, base64, in the order the build returned them."
                                    }
                                },
                                "required": [
                                    "claimId",
                                    "signed"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status and signature of every transaction.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid input: `{ error }`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Already submitted, or another claim is in flight.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limited: `{ error }`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Busy: the scan queue is full. Try again shortly.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
