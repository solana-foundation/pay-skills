    "/v1/rent/verify": {
      "post": {
        "operationId": "rentVerify",
        "summary": "Verify any condition before you buy, refundable $1 hold",
        "description": "Holds up to $1.00. You state the condition that would make a purchase unnecessary; the desk reads its device evidence and up to 3 public https URLs, and a model decides. True: $0.01 check fee, $0.99 returned. False: the need is real, $1.00 charged. Evidence does not settle it: nothing charged, $1.00 returned. A missing or invalid condition is a 400 before any payment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "condition": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "The fact that would make this purchase unnecessary, in plain English."
                  },
                  "evidence_urls": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string",
