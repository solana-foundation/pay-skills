{
  "openapi": "3.1.0",
  "info": {
    "title": "TVibe Signal",
    "version": "3.0.24",
    "description": "Free Solana mint risk gate for agents. Not financial advice."
  },
  "servers": [
    {
      "url": "https://signal-api-24q4.onrender.com"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable, honor Retry-After"
          }
        }
      }
    },
    "/omni": {
      "get": {
        "summary": "Primary risk gate",
        "operationId": "omni",
        "parameters": [
          {
            "name": "mint",
            "in": "query",
            "required": true,
            "description": "Solana mint address to evaluate",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "description": "Use view=agent for agent-optimized fields",
            "schema": {
              "type": "string",
              "enum": [
                "agent"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Risk gate result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "pass",
                        "review",
                        "skip"
                      ]
                    },
                    "filter": {
                      "type": "object",
                      "properties": {
                        "pass": {
                          "type": "boolean"
                        }
                      }
                    },
                    "unknowns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "valid_for_s": {
                      "type": "integer"
                    },
                    "nfa": {
                      "type": "boolean"
                    },
                    "mint": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid mint"
          },
          "429": {
            "description": "Rate limited, honor Retry-After"
          },
          "503": {
            "description": "Upstream unavailable, honor Retry-After"
          }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Public track record",
        "operationId": "stats",
        "responses": {
          "200": {
            "description": "Measured outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable, honor Retry-After"
          }
        }
      }
    },
    "/skill.json": {
      "get": {
        "summary": "Skill metadata",
        "operationId": "skill",
        "responses": {
          "200": {
            "description": "Skill metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable, honor Retry-After"
          }
        }
      }
    },
    "/ops/fair-use": {
      "get": {
        "summary": "Fair use policy",
        "operationId": "fair_use",
        "responses": {
          "200": {
            "description": "Fair use policy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable, honor Retry-After"
          }
        }
      }
    },
    "/agent/playbook": {
      "get": {
        "summary": "Agent playbook",
        "operationId": "playbook",
        "responses": {
          "200": {
            "description": "Agent workflow",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable, honor Retry-After"
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "Machine docs",
        "operationId": "llms",
        "responses": {
          "200": {
            "description": "Machine-readable docs",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable, honor Retry-After"
          }
        }
      }
    },
    "/mcp": {
      "get": {
        "summary": "MCP",
        "operationId": "mcp",
        "description": "MCP endpoint for agent clients. Listed in PAY.md, now present in the spec.",
        "responses": {
          "200": {
            "description": "MCP response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable, honor Retry-After"
          }
        }
      }
    }
  }
}
