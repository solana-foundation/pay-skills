{
  "openapi": "3.1.0",
  "info": {
    "title": "RugRadar",
    "version": "1.1.0",
    "description": "Solana token danger warnings for agents, paid per call with x402 (USDC on Solana). Errors are never charged: 400 bad input, 422 nothing found, 503 busy. Automated heuristic, may be wrong. Not financial advice."
  },
  "servers": [
    {
      "url": "https://x402-seller-pmlm.onrender.com"
    }
  ],
  "paths": {
    "/rug-check": {
      "get": {
        "operationId": "rugCheck",
        "summary": "Check a Solana token for rug risk (0-100 score)",
        "description": "Solana token rug check (incl. pump.fun): 0-100 risk score, plain-language reasons and a buyer summary from 45+ data points (mint/freeze authority, holder concentration, liquidity, dev holding/sold, snipers, bundles, live sell quote, creator history). $0.01 per call; failed calls are free. Automated heuristic, may be wrong. Not financial advice.",
        "tags": [
          "RugRadar"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Solana token mint address (mint= alias also accepted)",
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44
            }
          },
          {
            "name": "mint",
            "in": "query",
            "required": false,
            "description": "Alias for token",
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44
            }
          }
        ],
        "x-payment-info": {
          "protocols": [
            {
              "x402": {
                "version": 2,
                "scheme": "exact",
                "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
                "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
                "payTo": "3a9DUWEA34ejDaMbWo96gFfuqN2TvojJewUBCA14Dg75"
              }
            }
          ],
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.01"
          }
        },
        "responses": {
          "200": {
            "description": "Risk score and buyer signals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "product": {
                      "type": "string"
                    },
                    "chain": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "riskScore": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "riskLevel": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    },
                    "confidence": {
                      "type": "string"
                    },
                    "verdict": {
                      "type": "string"
                    },
                    "buyerSummary": {
                      "type": "string"
                    },
                    "signalCount": {
                      "type": "integer"
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "buyer": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "facts": {
                      "type": "object"
                    },
                    "disclaimer": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "riskScore",
                    "riskLevel",
                    "reasons",
                    "disclaimer",
                    "buyerSummary"
                  ]
                },
                "example": {
                  "product": "RugRadar",
                  "chain": "solana",
                  "token": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN",
                  "riskScore": 5,
                  "riskLevel": "low",
                  "confidence": "high",
                  "verdict": "No major high-risk patterns found.",
                  "buyerSummary": "No major high-risk patterns found. Still only buy what you can afford to lose.",
                  "signalCount": 48,
                  "reasons": [
                    "Mint authority is revoked: supply is fixed.",
                    "Freeze authority is revoked."
                  ],
                  "buyer": {
                    "canSell": true,
                    "sellImpactPct": 0.4,
                    "devSoldPctOfBought": 0,
                    "sniperSupplyPct10s": 2.1,
                    "volumeToMcap": 0.08,
                    "organicScore": 92
                  },
                  "disclaimer": "Automated heuristic, may be wrong. Not financial advice. Do your own research."
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid input (not charged)"
          },
          "402": {
            "description": "Payment required: x402 v2 challenge in PAYMENT-REQUIRED header"
          },
          "422": {
            "description": "Nothing usable found / target unreachable (not charged)"
          },
          "503": {
            "description": "Temporarily unavailable (not charged)"
          }
        }
      }
    },
