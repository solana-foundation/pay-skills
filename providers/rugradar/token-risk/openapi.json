    "/watch": {
      "get": {
        "operationId": "watchToken",
        "summary": "Create a 24h or 48h watch on a Solana token with webhook alerts",
        "description": "Watch one Solana token for 24h ($0.05) or 48h ($0.10). Re-checked about every 10 minutes; one HMAC-signed webhook alert per trigger when the dev sells, liquidity drops 30%+, mint/freeze authority appears, the risk score jumps 20+, or the token can't be sold.",
        "tags": [
          "RugRadar"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Solana mint address",
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 44
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "description": "24 ($0.05, default) or 48 ($0.10)",
            "schema": {
              "type": "string",
              "enum": [
                "24",
                "48"
              ]
            }
          },
          {
            "name": "webhook",
            "in": "query",
            "required": true,
            "description": "https URL for signed JSON POST alerts (X-RugRadar-Signature)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-payment-info": {
          "protocols": [
            {
              "x402": {
                "version": 2,
                "scheme": "exact",
                "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
                "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
                "payTo": "3a9DUWEA34ejDaMbWo96gFfuqN2TvojJewUBCA14Dg75"
              }
            }
          ],
          "price": {
            "mode": "dynamic",
            "currency": "USD",
            "min": "0.05",
            "max": "0.10",
            "note": "hours=24: 0.05, hours=48: 0.10"
          }
        },
        "responses": {
          "200": {
            "description": "Watch started (secret returned once)",
            "content": {
              "application/json": {
                "example": {
                  "watchId": "w_example",
                  "token": "JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN",
                  "status": "active",
                  "hours": 24,
                  "expiresAt": "2026-10-20T00:00:00.000Z",
                  "secret": "whsec_returned_once",
                  "checkEveryMin": 10
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid input (not charged)"
          },
          "402": {
            "description": "Payment required: x402 v2 challenge in PAYMENT-REQUIRED header"
          },
          "422": {
            "description": "Nothing usable found / target unreachable (not charged)"
          },
          "503": {
            "description": "Temporarily unavailable (not charged)"
          }
        }
      }
