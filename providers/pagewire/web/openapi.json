{
    "openapi": "3.1.0",
    "info": {
        "title": "PageWire \u2014 web pages for AI agents",
        "version": "1.0.0",
        "description": "Pay-per-call web reading for AI agents: any public page as clean Markdown, page metadata, and small same-site crawls. Pay per call with USDC \u2014 x402 (Base or Solana) or MPP (USDC.e on Tempo, USDC on Base); no account, no API key. Docs: https://pagewire.dev/#api",
        "contact": {
            "name": "PageWire",
            "url": "https://pagewire.dev/#api",
            "email": "starplayr@icloud.com"
        },
        "x-guidance": "Call any /x402/* endpoint with GET; a 402 answer carries the exact USDC amount and payTo in the PAYMENT-REQUIRED header (x402 v2 \u2014 pay with e.g. @x402/fetch) and the same price as MPP challenges in WWW-Authenticate: Payment (method tempo, USDC.e on Tempo; method evm, USDC on Base \u2014 pay with mppx). 4xx answers are never charged."
    },
    "x-service-info": {
        "categories": [
            "web-extraction",
            "scraping",
            "markdown",
            "tools"
        ],
        "docs": {
            "homepage": "https://pagewire.dev/",
            "apiReference": "https://pagewire.dev/#api",
            "llms": "https://pagewire.dev/llms.txt"
        }
    },
    "servers": [
        {
            "url": "https://pagewire.dev"
        }
    ],
    "paths": {
        "/x402": {
            "get": {
                "summary": "List the paid x402 endpoints and prices",
                "description": "Free JSON list of the paid endpoints with their x402 payment requirements and Bazaar schemas.",
                "security": [],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/x402/extract": {
            "get": {
                "summary": "Extract a web page as clean Markdown with links",
                "description": "Fetch a public web page and return its title, description, clean Markdown (scripts, styles, nav chrome removed) and the list of links. No model call, deterministic.",
                "security": [],
                "parameters": [
                    {
                        "name": "url",
                        "in": "query",
                        "required": true,
                        "description": "Public http(s) page to fetch",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "example": {
                                        "url": "https://example.com/",
                                        "status": 200,
                                        "title": "Example Domain",
                                        "description": null,
                                        "markdown": "This domain is for use in documentation examples without needing permission. This is not a service; avoid relying on it for testing and monitoring purposes.",
                                        "words": 25,
                                        "links": [],
                                        "truncated": false
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad input (never charged)"
                    },
                    "402": {
                        "description": "Payment Required \u2014 x402 v2 PAYMENT-REQUIRED header (base64 JSON, also in the body; retry with PAYMENT-SIGNATURE) and MPP WWW-Authenticate: Payment challenges (retry with Authorization: Payment)"
                    },
                    "422": {
                        "description": "Page could not be fetched or is not text (never charged)"
                    }
                },
                "x-payment-info": {
