        "/x402/crawl": {
            "get": {
                "summary": "Read a page plus up to 4 same-site linked pages as Markdown",
                "description": "Fetch a public web page plus up to 4 pages on the same host that it links to (in link order, or only those whose path starts with `prefix`), and return each one as title + clean Markdown. Good for reading a docs section or a small site in one call. No model call, deterministic.",
                "security": [],
                "parameters": [
                    {
                        "name": "url",
                        "in": "query",
                        "required": true,
                        "description": "Public http(s) page to fetch",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "prefix",
                        "in": "query",
                        "required": false,
                        "description": "Optional path prefix the linked pages must start with, e.g. /docs/",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "description": "Linked pages to read, 0-4 (default 4)",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "example": {
                                        "start": "https://example.com/",
                                        "pages": [
                                            {
                                                "url": "https://example.com/",
                                                "status": 200,
                                                "title": "Example Domain",
                                                "markdown": "This domain is for use in documentation examples.",
                                                "words": 8,
                                                "truncated": false
                                            }
                                        ],
