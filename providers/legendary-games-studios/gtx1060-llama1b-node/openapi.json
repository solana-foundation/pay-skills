{
    "info": {
        "description": "OpenAI-compatible chat completions served by Llama 3.2 1B on a single GTX 1060. Paid per request.",
        "title": "GTX 1060 Llama 3.2 1B Node",
        "version": "1.0.0"
    },
    "openapi": "3.0.3",
    "paths": {
        "/v1/chat/completions": {
            "post": {
                "description": "Send a list of chat messages and receive a model-generated reply. Priced per request. Best for short text processing, listing and utility tasks; context is limited to 2048 tokens.",
                "operationId": "createChatCompletion",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "max_tokens": {
                                        "description": "Maximum number of tokens to generate in the reply.",
                                        "type": "integer"
                                    },
                                    "messages": {
                                        "description": "Ordered list of chat messages that make up the conversation so far. The model replies to the last one.",
                                        "items": {
                                            "properties": {
                                                "content": {
                                                    "description": "Plain text content of the message.",
                                                    "example": "Summarize this paragraph in one sentence.",
                                                    "type": "string"
                                                },
                                                "role": {
                                                    "description": "Who authored this message.",
                                                    "enum": [
                                                        "system",
                                                        "user",
                                                        "assistant"
                                                    ],
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "role",
                                                "content"
                                            ],
                                            "type": "object"
                                        },
                                        "type": "array"
                                    },
                                    "model": {
                                        "description": "Model name to run. Use llama3.2:1b.",
                                        "example": "llama3.2:1b",
                                        "type": "string"
                                    },
                                    "stream": {
                                        "default": false,
                                        "description": "Stream the reply as server-sent events instead of returning it all at once.",
                                        "type": "boolean"
                                    },
                                    "temperature": {
                                        "description": "Sampling temperature. Lower values give more deterministic output.",
                                        "type": "number"
                                    }
                                },
                                "required": [
                                    "model",
                                    "messages"
                                ],
                                "type": "object"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Chat completion"
                    },
                    "402": {
                        "description": "Payment required"
                    }
                },
                "summary": "Generate text completions with Llama 3.2 1B",
                "x-pay-metering": {
                    "dimensions": [
                        {
                            "direction": "usage",
                            "scale": 1,
                            "tiers": [
                                {
                                    "price_usd": 2e-05
                                }
                            ],
                            "unit": "requests"
                        }
                    ],
                    "schemes": [
                        "mpp-charge"
                    ]
                }
            }
        }
    },
    "servers": [
        {
            "url": "https://almanac-pelt-lagging.ngrok-free.dev"
        }
    ]
}
