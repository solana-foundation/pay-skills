{
    "info": {
        "description": "OpenAI-compatible chat completions served by Llama 3.2 1B on a single GTX 1060. Paid per request.",
        "title": "GTX 1060 Llama 3.2 1B Node",
        "version": "1.0.0"
    },
    "openapi": "3.0.3",
    "paths": {
        "/v1/chat/completions": {
            "post": {
                "description": "Send a list of chat messages and receive a model-generated reply. Priced per request. Best for short text processing, listing and utility tasks; context is limited to 2048 tokens.",
                "operationId": "createChatCompletion",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "max_tokens": {
                                        "description": "Maximum number of tokens to generate in the reply.",
                                        "type": "integer"
                                    },
                                    "messages": {
                                        "description": "Ordered list of chat messages that make up the conversation so far. The model replies to the last one.",
                                        "items": {
                                            "properties": {
                                                "content": {
                                                    "description": "Plain text content of the message.",
                                                    "example": "Summarize this paragraph in one sentence.",
                                                    "type": "string"
                                                },
                                                "role": {
                                                    "description": "Who authored this message.",
                                                    "enum": [
                                                        "system",
                                                        "user",
                                                        "assistant"
                                                    ],
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "role",
                                                "content"
                                            ],
                                            "type": "object"
                                        },
                                        "type": "array"
                                    },
                                    "model": {
                                        "description": "Model name to run. Use llama3.2:1b.",
                                        "example": "llama3.2:1b",
                                        "type": "string"
                                    },
                                    "stream": {
                                        "default": false,
                                        "description": "When false (default) the reply is one JSON object. When true the reply is a server-sent event stream of chunk objects ending with [DONE].",
                                        "type": "boolean"
                                    },
                                    "temperature": {
                                        "description": "Sampling temperature. Lower values give more deterministic output.",
                                        "type": "number"
                                    }
                                },
                                "required": [
                                    "model",
                                    "messages"
                                ],
                                "type": "object"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "description": "Complete chat completion returned when stream is false.",
                                    "properties": {
                                        "choices": {
                                            "description": "Generated replies. Normally one entry; the text is in choices[0].message.content.",
                                            "items": {
                                                "properties": {
                                                    "finish_reason": {
                                                        "description": "Why generation stopped, for example stop or length.",
                                                        "example": "stop",
                                                        "type": "string"
                                                    },
                                                    "index": {
                                                        "description": "Position of this choice in the list.",
                                                        "type": "integer"
                                                    },
                                                    "message": {
                                                        "description": "The generated assistant message.",
                                                        "properties": {
                                                            "content": {
                                                                "description": "The generated text.",
                                                                "type": "string"
                                                            },
                                                            "role": {
                                                                "description": "Author of the reply, always assistant.",
                                                                "example": "assistant",
                                                                "type": "string"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            },
                                            "type": "array"
                                        },
                                        "created": {
                                            "description": "Unix timestamp (seconds) of when the completion was created.",
                                            "type": "integer"
                                        },
                                        "id": {
                                            "description": "Unique identifier for this completion.",
                                            "type": "string"
                                        },
                                        "model": {
                                            "description": "Model that produced the reply.",
                                            "example": "llama3.2:1b",
                                            "type": "string"
                                        },
                                        "object": {
                                            "description": "Object type, always chat.completion.",
                                            "example": "chat.completion",
                                            "type": "string"
                                        },
                                        "usage": {
                                            "description": "Token counts for this request. Billing is per request, not per token.",
                                            "properties": {
                                                "completion_tokens": {
                                                    "description": "Tokens in the generated reply.",
                                                    "type": "integer"
                                                },
                                                "prompt_tokens": {
                                                    "description": "Tokens in the input messages.",
                                                    "type": "integer"
                                                },
                                                "total_tokens": {
                                                    "description": "Prompt plus completion tokens.",
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            },
                            "text/event-stream": {
                                "schema": {
                                    "description": "Server-sent event stream returned when stream is true. Each event is a line starting with data: followed by a JSON chunk object (object chat.completion.chunk) whose generated text fragment is in choices[0].delta.content. The final event is data: [DONE].",
                                    "example": "data: {\"id\":\"chatcmpl-1\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"},\"finish_reason\":null}]}\n\ndata: [DONE]\n\n",
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Chat completion. JSON object when stream is false, server-sent event stream when stream is true."
                    },
                    "402": {
                        "description": "Payment required"
                    }
                },
                "summary": "Generate text completions with Llama 3.2 1B",
                "x-pay-metering": {
                    "dimensions": [
                        {
                            "direction": "usage",
                            "scale": 1,
                            "tiers": [
                                {
                                    "price_usd": 2e-05
                                }
                            ],
                            "unit": "requests"
                        }
                    ],
                    "schemes": [
                        "mpp-charge"
                    ]
                }
            }
        }
    },
    "servers": [
        {
            "url": "https://almanac-pelt-lagging.ngrok-free.dev"
        }
    ]
}
