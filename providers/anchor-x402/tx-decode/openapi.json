          },
          "tx_hash": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Tx Hash"
          }
        },
        "type": "object",
        "required": [
          "chain",
          "tx_hash"
        ],
        "title": "TxDecodeRequest"
