{
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "properties": {
          "max_tokens": {
            "description": "Maximum number of tokens to generate in the completion.",
            "type": "integer"
          },
          "messages": {
            "description": "OpenAI-compatible chat-completions message list, in conversation order.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "minItems": 1,
            "type": "array"
          },
          "model": {
            "description": "Model Studio model name selected by the caller (e.g. \"qwen3-max\", \"qwen-max\", \"qwen-plus\", \"qwen-flash\", \"qwen3-coder-plus\").",
            "type": "string"
          },
          "stream": {
            "description": "Whether to request streaming output (server-sent events) for supported models.",
            "type": "boolean"
          },
          "temperature": {
            "description": "Sampling temperature. Higher values produce more diverse output.",
            "type": "number"
          },
          "tool_choice": {
            "description": "Controls tool selection: \"none\", \"auto\", or a specific tool reference object.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          },
          "tools": {
            "description": "Tool definitions the model may call, in OpenAI-compatible function-calling format.",
            "items": {
              "$ref": "#/components/schemas/Tool"
            },
            "type": "array"
          },
          "top_p": {
            "description": "Nucleus sampling probability mass.",
            "type": "number"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "type": "object"
      },
      "ChatCompletionResponse": {
        "properties": {
          "choices": {
            "items": {
              "properties": {
                "finish_reason": {
                  "type": "string"
                },
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "created": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "usage": {
            "properties": {
              "completion_tokens": {
                "type": "integer"
              },
              "prompt_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "ChatMessage": {
        "properties": {
          "content": {
            "description": "Message content. For OpenAI-compatible chat completions, this is the prompt or response text. May be null on assistant messages that carry only tool_calls.",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ],
            "type": "string"
          },
          "tool_call_id": {
            "description": "For role \"tool\" messages, the id of the tool call this message responds to.",
            "type": "string"
          },
          "tool_calls": {
            "description": "Tool calls emitted by the assistant, in OpenAI-compatible function-calling format.",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "type": "array"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "properties": {
                  "code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "param": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            ]
          },
          "request_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Tool": {
        "properties": {
          "function": {
            "description": "Function definition the model may call: name, description, and JSON Schema parameters.",
            "properties": {
              "description": {
                "description": "Human-readable description of what the function does, used by the model to decide when to call it.",
                "type": "string"
              },
              "name": {
                "description": "Function name the model uses in tool calls (e.g. \"get_weather\").",
                "type": "string"
              },
              "parameters": {
                "description": "JSON Schema describing the function arguments.",
                "type": "object"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": {
            "enum": [
              "function"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "function"
        ],
        "type": "object"
      },
      "ToolCall": {
        "properties": {
          "function": {
            "properties": {
              "arguments": {
                "description": "JSON-encoded function arguments.",
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "function"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ModelList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Model identifier, e.g. qwen3-max."
                },
                "object": {
                  "type": "string"
                },
                "owned_by": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "info": {
    "description": "Filtered OpenAPI description for the Qwen chat completions proxy. The upstream endpoint is Alibaba Cloud Model Studio's OpenAI-compatible chat completions API in the Singapore region; the caller selects the Qwen model via the request `model` field.",
    "title": "Alibaba Cloud Model Studio (Qwen) API",
    "version": "v1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/compatible-mode/v1/chat/completions": {
      "post": {
        "description": "Submit a chat completion request to a caller-selected Qwen model. The request body mirrors Alibaba Cloud Model Studio's OpenAI-compatible chat completions format, including multi-turn messages, sampling options, streaming, and tool calling.",
        "operationId": "alibaba.modelstudio.chatCompletions",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "messages": [
                  {
                    "content": "You are a concise assistant.",
                    "role": "system"
                  },
                  {
                    "content": "Explain the difference between a mutex and a semaphore in two sentences.",
                    "role": "user"
                  }
                ],
                "model": "qwen-flash"
              },
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            },
            "description": "Successful chat completion response."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request."
          }
        },
        "summary": "Create a chat completion with a Qwen model",
        "tags": [
          "openai"
        ],
        "x-pay-metering": {
          "schemes": [
            "mpp-session",
            "x402-upto"
          ],
          "upto": {
            "max_usd": 0.1,
            "missing_usage": "refund",
            "response_body": {
              "mode": "buffer",
              "max_bytes": 33554432
            }
          },
          "dimensions": [
            {
              "direction": "input",
              "unit": "tokens",
              "scale": 1000000,
              "tiers": [
                {
                  "price_usd": 6.0,
                  "notes": "Conservative fallback: qwen3-coder-plus 256K-1M input list price."
                }
              ]
            },
