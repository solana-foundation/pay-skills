{
    "openapi":  "3.0.3",
    "info":  {
                 "title":  "Machine-Payable Square API",
                 "version":  "1.0.0",
                 "description":  "A minimal x402-paid API for autonomous agent payment and tool-discovery experiments."
             },
    "servers":  [
                    {
                        "url":  "https://agent-vending-lab-v2.amctechsc.workers.dev"
                    }
                ],
    "paths":  {
                  "/api/square-solana":  {
                                             "get":  {
                                                         "operationId":  "squareNumber",
                                                         "summary":  "Calculate the square of a number",
                                                         "description":  "Returns the mathematical square of a finite number after satisfying the advertised x402 payment.",
                                                         "parameters":  [
                                                                            {
                                                                                "name":  "number",
                                                                                "in":  "query",
                                                                                "required":  true,
                                                                                "description":  "Finite number to square",
                                                                                "schema":  {
                                                                                               "type":  "number"
                                                                                           },
                                                                                "example":  12
                                                                            }
                                                                        ],
                                                         "responses":  {
                                                                           "200":  {
                                                                                       "description":  "Successful paid calculation",
                                                                                       "content":  {
                                                                                                       "application/json":  {
                                                                                                                                "schema":  {
                                                                                                                                               "type":  "object",
                                                                                                                                               "required":  [
                                                                                                                                                                "input",
                                                                                                                                                                "square",
                                                                                                                                                                "served_at"
                                                                                                                                                            ],
                                                                                                                                               "properties":  {
                                                                                                                                                                  "input":  {
                                                                                                                                                                                "type":  "number"
                                                                                                                                                                            },
                                                                                                                                                                  "square":  {
                                                                                                                                                                                 "type":  "number"
                                                                                                                                                                             },
                                                                                                                                                                  "served_at":  {
                                                                                                                                                                                    "type":  "string",
                                                                                                                                                                                    "format":  "date-time"
                                                                                                                                                                                }
                                                                                                                                                              }
                                                                                                                                           }
                                                                                                                            }
                                                                                                   }
                                                                                   },
                                                                           "402":  {
                                                                                       "description":  "x402 payment required"
                                                                                   }
                                                                       }
                                                     }
                                         }
              }
}