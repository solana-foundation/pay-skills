{
  "openapi": "3.1.0",
  "info": {
    "title": "Fizzl Buy",
    "version": "1.1.0",
    "termsOfService": "https://fizzl.eu/terms/",
    "description": "The inkoper: one call buys the right paid x402 API for your agent, picked by x402 Doctor's track records, and returns the answer checked by TypeSafe Jev.",
    "contact": {
      "name": "Fizzl",
      "url": "https://fizzl.eu",
      "email": "Fizzl13@protonmail.com"
    },
    "x-guidance": "POST /v1/buy with {\"need\": \"<what you need, with the details>\"} and pay $0.02 over x402. You get the answer, which service it came from and what it cost. Nothing is charged when no service delivers. To see first what would be bought, GET /v1/pick?need=… (free)."
  },
  "servers": [
    {
      "url": "https://buy.fizzl.eu"
    }
  ],
  "paths": {
    "/v1/buy": {
      "post": {
        "operationId": "buy",
        "summary": "Buy the right paid API for a need and return its answer",
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.02"
          },
          "protocols": [
            {
              "x402": {}
            }
          ],
          "networks": [
            "eip155:8453",
            "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
          ],
          "asset": "USDC"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "need": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500,
                    "description": "What you need, in plain words with the details (place, date, ticker, currency pair)",
                    "example": "weather forecast for Amsterdam tomorrow"
                  }
                },
                "required": [
                  "need"
                ]
              },
              "example": {
                "need": "weather forecast for Amsterdam tomorrow"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The answer, bought and checked",
            "content": {
              "application/json": {
                "example": {
                  "need": "weather forecast for Amsterdam tomorrow",
                  "delivered": true,
                  "answer": {
                    "place": "Amsterdam",
                    "daily": [
                      {
                        "date": "2026-10-24",
                        "min_c": 8,
                        "max_c": 13,
                        "condition": "light rain"
                      }
                    ]
                  },
                  "service": {
                    "url": "https://weather.cyberwarex.com/forecast?place=Amsterdam&days=2",
                    "method": "GET",
                    "track_record": {
                      "days": 30,
                      "payableDays": 30,
                      "ratio": 1
                    }
                  },
                  "paid_usd": 0.002,
                  "answer_check": {
                    "delivered": {
                      "verdict": "yes",
                      "decidedBy": "jev"
                    },
                    "injection": {
                      "flagged": false
                    }
                  },
                  "tried": 1
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; nothing is charged"
          },
          "402": {
            "description": "Payment Required"
          },
          "404": {
            "description": "No suitable service; nothing is charged"
          },
          "502": {
            "description": "No service delivered; nothing is charged"
          },
          "503": {
            "description": "Budget or wallet empty; nothing is charged"
          }
        }
      }
    },
    "/v1/pick": {
      "get": {
        "operationId": "pick",
        "security": [],
        "summary": "Fetch the paid API that would be bought for a need",
        "parameters": [
          {
            "name": "need",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 500,
              "example": "weather forecast for Amsterdam tomorrow"
            },
            "description": "What you need, in plain words with the details"
          }
        ],
        "responses": {
          "200": {
            "description": "The pick, alternatives and how to buy"
          },
          "429": {
            "description": "Free limit reached"
          }
        },
        "description": "Free: no payment needed."
      }
    }
  }
}
