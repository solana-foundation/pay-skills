{
  "openapi": "3.1.0",
  "info": {
    "title": "APEX Faucet reads",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://apexfaucet.xyz"
    }
  ],
  "paths": {
    "/api/x402/page-markdown": {
      "get": {
        "operationId": "pageMarkdown",
        "summary": "Turn one public web page into clean Markdown",
        "description": "Render one public web page in a real browser and return its main content as Markdown.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "The public http(s) page to read.",
            "schema": {
              "type": "string"
            },
            "example": "https://example.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Page as Markdown."
          },
          "402": {
            "description": "Payment required. USDC on Solana, 0.002 per call. A missing or wrong input also answers 402, with a hint naming it."
          }
        },
        "x-payment-info": {
          "protocols": [
            "x402"
          ],
          "price": "$0.002"
        }
      }
    },
    "/api/x402/page-extract": {
      "get": {
        "operationId": "pageExtract",
        "summary": "Extract one public web page into a structured read",
        "description": "Render one public web page in a real browser and return its title, description, headings, visible text and outbound links.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "The public http(s) page to read.",
            "schema": {
              "type": "string"
            },
            "example": "https://example.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Page extract."
          },
          "402": {
            "description": "Payment required. USDC on Solana, 0.009 per call. A missing or wrong input also answers 402, with a hint naming it."
          }
        },
        "x-payment-info": {
          "protocols": [
            "x402"
          ],
          "price": "$0.009"
        }
      }
    },
    "/api/x402/evm-token-info": {
      "get": {
        "operationId": "evmTokenInfo",
        "summary": "Read one EVM token contract and return its fields",
        "description": "Return token info for one contract.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "The token contract address (0x and 40 hex).",
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "example": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
          }
        ],
        "responses": {
          "200": {
            "description": "Token read."
          },
          "402": {
            "description": "Payment required. USDC on Solana, 0.001 per call. A missing or wrong input also answers 402, with a hint naming it."
          }
        },
        "x-payment-info": {
          "protocols": [
            "x402"
          ],
          "price": "$0.001"
        }
      }
    },
    "/api/x402/nft-info": {
      "get": {
        "operationId": "nftInfo",
        "summary": "Read one NFT by contract address and token id",
        "description": "Return info for one NFT contract and token id.",
        "parameters": [
          {
            "name": "contract",
            "in": "query",
            "required": true,
            "description": "The NFT contract address (0x and 40 hex).",
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "example": "0xBC4CA0EdA7647A8aB7C2061c2E118A18a936f13D"
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The token id.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,78}$"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "NFT read."
          },
          "402": {
            "description": "Payment required. USDC on Solana, 0.001 per call. A missing or wrong input also answers 402, with a hint naming it."
          }
        },
        "x-payment-info": {
          "protocols": [
            "x402"
          ],
          "price": "$0.001"
        }
      }
    },
    "/api/x402/bloodstream-cells": {
      "get": {
        "operationId": "bloodstreamCells",
        "summary": "Read the current bloodstream cell sample",
        "description": "Return the current cell sample. This route takes no query.",
        "responses": {
          "200": {
            "description": "Cell sample."
          },
          "402": {
            "description": "Payment required. USDC on Solana, 0.001 per call."
          }
        },
        "x-payment-info": {
          "protocols": [
            "x402"
          ],
          "price": "$0.001"
        }
      }
    },
    "/api/x402/chat-completions": {
      "post": {
        "operationId": "chatCompletions",
        "summary": "One OpenAI-compatible chat completion",
        "description": "POST an OpenAI-style chat completion body. The whole answer comes back in one response (no streaming). An unpaid POST answers 402 with the price.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "gpt-oss-120b",
                      "gpt-oss-20b",
                      "llama-3.3-70b",
                      "llama-3.1-8b",
                      "qwen3-30b"
                    ],
                    "default": "gpt-oss-120b"
                  },
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "system",
                            "user",
                            "assistant",
                            "developer",
                            "tool"
                          ]
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  },
                  "temperature": {
                    "type": "number"
                  }
                }
              },
              "example": {
                "model": "gpt-oss-120b",
                "messages": [
                  {
                    "role": "user",
                    "content": "Say hello in five words."
                  }
                ],
                "max_tokens": 64
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An OpenAI-compatible chat.completion object."
          },
          "402": {
            "description": "Payment required. USDC on Solana, 0.002 per call."
          }
        },
        "x-payment-info": {
          "protocols": [
            "x402"
          ],
          "price": "$0.002"
        }
      }
    }
  }
}
