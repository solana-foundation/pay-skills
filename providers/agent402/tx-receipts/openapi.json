{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent402 transaction receipts",
    "version": "1",
    "description": "Receipts for Solana mainnet transactions, read from Solana RPC. Paid per request over x402 (USDC on Solana). Run by the Agent402 toolkit developer. Facts from the chain only: no prices, judgments or tax treatment."
  },
  "servers": [
    {
      "url": "https://agent402-tx-receipts.agent402-ebc.workers.dev"
    }
  ],
  "paths": {
    "/x402/receipts": {
      "post": {
        "operationId": "receipts",
        "summary": "Get receipts for up to 20 Solana transaction signatures",
        "description": "Return one receipt per signature (status, block time, fee and fee payer, signers, programs, SOL and token balance changes per owner, memos) plus a CSV of balance changes. 0.05 USDC per request over x402. Malformed input is refused with 400 before any payment is asked. If none of the signatures are found, the request fails with 422 and the payment is not settled.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "signatures"
                ],
                "properties": {
                  "signatures": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "description": "Base58 Solana transaction signature"
                    }
                  }
                }
              },
              "example": {
                "signatures": [
                  "5VERv8NMvzbJMEkV8xnrLkEaWRtSz9CosKDYjCJjBRnbJLgp8uirBgmQpjKhoR4tjF3ZpRzrFmBV6UjKdiSZkQUW"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Receipts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "receipts": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "csv": {
                      "type": "string"
                    },
                    "csvColumns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "requested": {
                          "type": "integer"
                        },
                        "found": {
                          "type": "integer"
                        },
                        "notFound": {
                          "type": "integer"
                        },
                        "commitment": {
                          "type": "string"
                        },
                        "generatedAt": {
                          "type": "string"
                        }
                      }
                    },
                    "notes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed input. No payment was requested."
          },
          "402": {
            "description": "Payment required (x402 v2, exact scheme, USDC on Solana mainnet)."
          },
          "422": {
            "description": "None of the signatures were found. The payment was not settled."
          }
        }
      },
      "get": {
        "operationId": "receiptsByQuery",
        "summary": "Same as POST, with signatures in the query string",
        "description": "Comma-separated signatures in ?signatures= (up to 20). Same price and rules as POST.",
        "parameters": [
          {
            "name": "signatures",
            "in": "query",
            "required": true,
            "description": "Comma-separated base58 Solana transaction signatures (1 to 20)",
            "schema": {
              "type": "string"
            },
            "example": "5VERv8NMvzbJMEkV8xnrLkEaWRtSz9CosKDYjCJjBRnbJLgp8uirBgmQpjKhoR4tjF3ZpRzrFmBV6UjKdiSZkQUW"
          }
        ],
        "responses": {
          "200": {
            "description": "Receipts (same body as POST)"
          },
          "400": {
            "description": "Malformed input. No payment was requested."
          },
          "402": {
            "description": "Payment required (x402 v2, exact scheme, USDC on Solana mainnet)."
          },
          "422": {
            "description": "None of the signatures were found. The payment was not settled."
          }
        }
      }
    }
  }
}
