{
  "openapi": "3.1.0",
  "info": {
    "title": "PriorSeal x402 API",
    "version": "1.0.0",
    "description": "The catalog-scoped paid integration-readiness endpoint."
  },
  "servers": [
    {
      "url": "https://priorseal.xyz"
    }
  ],
  "paths": {
    "/v1/integration-readiness": {
      "get": {
        "operationId": "getIntegrationReadiness",
        "summary": "Fetch a signed EVM integration-readiness report",
        "parameters": [
          {
            "name": "chainId",
            "in": "query",
            "required": true,
            "description": "EVM chain ID to inspect.",
            "example": 8453,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          {
            "name": "subjectAddress",
            "in": "query",
            "required": true,
            "description": "Public EVM address whose bytecode presence is checked.",
            "example": "0x0000000000000000000000000000000000000000",
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A short-lived Ed25519-signed, read-only integration-readiness report.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["schema", "readinessId", "issuedAt", "expiresAt", "input", "inspection", "payment", "signature"],
                  "properties": {
                    "schema": {
                      "type": "string",
                      "const": "priorseal.integration-readiness.v1"
                    },
                    "readinessId": {
                      "type": "string",
                      "pattern": "^pir_[0-9a-f]{32}$"
                    },
                    "issuedAt": {
                      "type": "integer"
                    },
                    "expiresAt": {
                      "type": "integer"
                    },
                    "input": {
                      "type": "object"
                    },
                    "inspection": {
                      "type": "object"
                    },
                    "payment": {
                      "type": "object"
                    },
                    "signature": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing chainId or subjectAddress."
          },
          "402": {
            "description": "Payment Required. PAYMENT-REQUIRED contains the live x402 v2 payment quote.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 payment requirements.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Payment service or inspection dependencies are unavailable."
          }
        }
      }
    }
  }
}
