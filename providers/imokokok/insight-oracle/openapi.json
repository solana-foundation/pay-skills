{
  "openapi": "3.1.0",
  "info": {
    "title": "Insight Oracle x402 API",
    "version": "1.0.0",
    "description": "The catalog-scoped paid pre-trade safety endpoint."
  },
  "servers": [
    {
      "url": "https://www.oracleinsight.xyz"
    }
  ],
  "paths": {
    "/api/v1/safety/pre-trade": {
      "get": {
        "operationId": "preTradeSafetyCheck",
        "summary": "Fetch an oracle safety assessment for a proposed DeFi action",
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "required": true,
            "description": "Asset symbol.",
            "schema": {
              "type": "string",
              "examples": ["ETH"]
            }
          },
          {
            "name": "chainId",
            "in": "query",
            "required": true,
            "description": "EVM chain ID.",
            "schema": {
              "type": "integer",
              "examples": [1]
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": true,
            "description": "Proposed DeFi action.",
            "schema": {
              "type": "string",
              "enum": ["swap", "borrow", "lend", "liquidate", "repay"],
              "example": "swap"
            }
          },
          {
            "name": "tradeAmountUsd",
            "in": "query",
            "required": true,
            "description": "Proposed trade size in USD.",
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0,
              "examples": [1000]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A pre-trade oracle safety verdict and evidence."
          },
          "400": {
            "description": "Invalid query parameters."
          },
          "402": {
            "description": "Payment Required. PAYMENT-REQUIRED contains the live x402 v2 payment quote.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 payment requirements.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
