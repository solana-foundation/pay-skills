{
  "openapi": "3.0.0",
  "info": {
    "title": "User-Agent Parser",
    "version": "1.0.0",
    "description": "Parse browser user-agent strings into structured data."
  },
  "servers": [
    {
      "url": "https://ua-parser-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {
    "/parse": {
      "post": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userAgent"
                ],
                "properties": {
                  "userAgent": {
                    "type": "string",
                    "description": "The raw User-Agent string to parse"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}