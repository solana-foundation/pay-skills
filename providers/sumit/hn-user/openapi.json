{
  "openapi": "3.0.0",
  "info": {
    "title": "HackerNews User Stats",
    "version": "1.0.0",
    "description": "Retrieve an HN user's karma, account age, and recent activity aggregated."
  },
  "servers": [
    {
      "url": "https://hn-user-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {
    "/hn-user/{username}": {
      "get": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        },
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The username to look up"
          }
        ]
      }
    }
  }
}