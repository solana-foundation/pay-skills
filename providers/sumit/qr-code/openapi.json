{
  "openapi": "3.0.0",
  "info": {
    "title": "QR Code Generator",
    "version": "1.0.0",
    "description": "Generate QR code images from text or URLs."
  },
  "servers": [
    {
      "url": "https://qr-code-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {
    "/generate": {
      "post": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The text or URL to encode in the QR code"
                  },
                  "size": {
                    "type": "integer",
                    "default": 200,
                    "description": "Output image size in pixels"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}