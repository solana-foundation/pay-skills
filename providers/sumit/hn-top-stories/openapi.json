{
  "openapi": "3.0.0",
  "info": {
    "title": "HackerNews Top Stories",
    "version": "1.0.0",
    "description": "Fetch and combine the top stories from HackerNews into a single JSON array, saving multiple API calls."
  },
  "servers": [
    {
      "url": "https://hn-top-stories-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {
    "/top-stories": {
      "post": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "default": 10,
                    "description": "Number of top stories to return (max 30)"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}