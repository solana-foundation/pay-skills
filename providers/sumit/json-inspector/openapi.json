{
  "openapi": "3.0.0",
  "info": {
    "title": "JSON/API Inspector Agent",
    "version": "1.0.0",
    "description": "Fetch a public JSON API and optionally extract fields via JMESPath."
  },
  "servers": [
    {
      "url": "https://json-inspector-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {
    "/inspect": {
      "post": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "The public JSON API endpoint to fetch"
                  },
                  "jmespath": {
                    "type": "string",
                    "description": "Optional JMESPath expression to filter the response"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}