{
  "openapi": "3.0.0",
  "info": {
    "title": "Math Expression Evaluator",
    "version": "1.0.0",
    "description": "Evaluate complex mathematical expressions safely."
  },
  "servers": [
    {
      "url": "https://math-eval-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {
    "/evaluate": {
      "post": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expression"
                ],
                "properties": {
                  "expression": {
                    "type": "string",
                    "description": "The mathematical expression to evaluate (e.g. '2^10 + sqrt(9)')"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}