{
  "openapi": "3.0.0",
  "info": {
    "title": "GitHub Repository Info",
    "version": "1.0.0",
    "description": "Fetch current public information about a GitHub repository, including its metadata, stars, forks, issues, and other key repository details."
  },
  "servers": [
    {
      "url": "https://github-repo-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {
    "/github/{owner}/{repo}": {
      "get": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        },
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The owner to look up"
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The repo to look up"
          }
        ]
      }
    }
  }
}