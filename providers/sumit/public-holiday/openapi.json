{
  "openapi": "3.0.0",
  "info": {
    "title": "Public Holidays Calendar",
    "version": "1.0.0",
    "description": "Lists public holidays for a given year and country using Nager.Date."
  },
  "servers": [
    {
      "url": "https://public-holiday-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {

    "/holidays/:year/:country": {
      "get": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        }
      }
    }

  }
}
