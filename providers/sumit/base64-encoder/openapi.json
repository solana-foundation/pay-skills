{
  "openapi": "3.0.0",
  "info": {
    "title": "Base64 Encoder/Decoder",
    "version": "1.0.0",
    "description": "Encode and decode base64 strings."
  },
  "servers": [
    {
      "url": "https://base64-encoder-pay.sumitg3767.workers.dev"
    }
  ],
  "paths": {
    "/process": {
      "post": {
        "summary": "Execute the requested task via the remote agent",
        "description": "Proxy to upstream agent",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "402": {
            "description": "Payment Required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "mode"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The string to encode or decode"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "encode",
                      "decode"
                    ],
                    "description": "Whether to encode or decode"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}