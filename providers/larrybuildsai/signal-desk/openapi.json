{
  "openapi": "3.1.0",
  "info": {
    "title": "Signal Desk by LarryBuildsAI",
    "version": "1.0.0",
    "description": "Low-cost buyer-side spend-routing and public-data preflights for agents."
  },
  "servers": [
    {
      "url": "https://proofbeforepay.vercel.app"
    }
  ],
  "paths": {
    "/v1/revenue/agent-router/quote": {
      "post": {
        "operationId": "quoteAgentRoute",
        "summary": "Create an agent route quote",
        "description": "Recommend a bounded tool route before an agent buys model, search, enrichment, or market-data calls.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["task"],
                "properties": {
                  "task": {"type": "string", "description": "Plain-language agent task or goal to route."},
                  "max_budget_usd": {"type": "number"},
                  "risk_tolerance": {"type": "string", "enum": ["low", "medium", "high"]}
                }
              },
              "example": {
                "task": "Choose a low-cost public web research route",
                "max_budget_usd": 0.25,
                "risk_tolerance": "low"
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Paid route quote"},
          "402": {"$ref": "#/components/responses/PaymentRequired"}
        },
        "x-x402-price": {"amount": "0.03", "asset": "USDC"}
      }
    },
    "/v1/revenue/lead-enrichment/brief": {
      "post": {
        "operationId": "generatePublicLeadBrief",
        "summary": "Generate a public lead brief",
        "description": "Create a public website and buyer brief with source paths, missing fields, and bounded next actions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {"type": "string", "format": "uri"},
                  "company": {"type": "string"},
                  "target_buyer": {"type": "string"}
                }
              },
              "example": {"url": "https://example.com"}
            }
          }
        },
        "responses": {
          "200": {"description": "Paid public lead brief"},
          "402": {"$ref": "#/components/responses/PaymentRequired"}
        },
        "x-x402-price": {"amount": "0.03", "asset": "USDC"}
      }
    },
    "/v1/revenue/defi/token-risk": {
      "post": {
        "operationId": "scoreDefiTokenRisk",
        "summary": "Create a DeFi token-risk snapshot",
        "description": "Score public or caller-supplied liquidity, volatility, pair-age, and data-availability signals.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token_address"],
                "properties": {
                  "token_address": {"type": "string", "description": "EVM token address or Solana mint address to assess."},
                  "chain": {"type": "string", "enum": ["base", "ethereum", "solana", "polygon", "arbitrum", "optimism", "bsc", "unknown"]},
                  "market_data": {"type": "object"}
                }
              },
              "example": {
                "token_address": "0x0000000000000000000000000000000000000001",
                "chain": "base"
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Paid token-risk snapshot"},
          "402": {"$ref": "#/components/responses/PaymentRequired"}
        },
        "x-x402-price": {"amount": "0.01", "asset": "USDC"}
      }
    },
    "/v1/revenue/market-gap/compare": {
      "post": {
        "operationId": "compareMarketToolOptions",
        "summary": "Create a market-tool comparison",
        "description": "Compare public marketplace tool options before an agent chains several paid services.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["task"],
                "properties": {
                  "task": {"type": "string", "description": "Plain-language tool or market decision to compare."},
                  "category": {"type": "string"},
                  "max_options": {"type": "number"}
                }
              },
              "example": {"task": "Compare public web research tools", "max_options": 4}
            }
          }
        },
        "responses": {
          "200": {"description": "Paid market-tool comparison"},
          "402": {"$ref": "#/components/responses/PaymentRequired"}
        },
        "x-x402-price": {"amount": "0.03", "asset": "USDC"}
      }
    }
  },
  "components": {
    "responses": {
      "PaymentRequired": {"description": "x402 payment required"}
    }
  }
}
