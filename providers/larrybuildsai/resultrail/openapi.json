{
  "openapi": "3.1.0",
  "info": {
    "title": "ResultRail by LarryBuildsAI",
    "version": "1.0.0",
    "description": "Pay-per-success public domain and URL result packs with source and receipt evidence."
  },
  "servers": [
    {
      "url": "https://proofbeforepay.vercel.app"
    }
  ],
  "paths": {
    "/v1/resultrail/domain": {
      "post": {
        "operationId": "enrichDomainResult",
        "summary": "Create a public domain result pack",
        "description": "Return public company, industry, technology, useful-path, source, confidence, and receipt evidence for one domain.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["domain"],
                "properties": {
                  "domain": {"type": "string", "description": "Public company or organization domain to inspect."},
                  "max_price_usdc": {"type": "string"},
                  "required_fields": {"type": "array", "items": {"type": "string"}}
                }
              },
              "example": {"domain": "example.com", "max_price_usdc": "0.12"}
            }
          }
        },
        "responses": {
          "200": {"description": "Paid public domain result"},
          "402": {"$ref": "#/components/responses/PaymentRequired"}
        },
        "x-x402-price": {"amount": "0.12", "asset": "USDC"}
      }
    },
    "/v1/resultrail/extract": {
      "post": {
        "operationId": "extractUrlResult",
        "summary": "Create a public URL extraction pack",
        "description": "Return page metadata, headings, links, text preview, source, confidence, and receipt evidence for one public URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {"type": "string", "format": "uri"},
                  "max_price_usdc": {"type": "string"},
                  "output": {"type": "string", "enum": ["summary", "markdown", "json"]}
                }
              },
              "example": {"url": "https://example.com", "max_price_usdc": "0.05", "output": "summary"}
            }
          }
        },
        "responses": {
          "200": {"description": "Paid public URL extraction result"},
          "402": {"$ref": "#/components/responses/PaymentRequired"}
        },
        "x-x402-price": {"amount": "0.05", "asset": "USDC"}
      }
    }
  },
  "components": {
    "responses": {
      "PaymentRequired": {"description": "x402 payment required"}
    }
  }
}
