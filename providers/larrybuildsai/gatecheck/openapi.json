{
  "openapi": "3.1.0",
  "info": {
    "title": "GateCheck by LarryBuildsAI",
    "version": "1.0.0",
    "description": "Read-only x402 and MCP seller-readiness checks, unpaid 402 health probes, deterministic receipts, and marketplace launch artifacts."
  },
  "servers": [
    {
      "url": "https://proofbeforepay.vercel.app"
    }
  ],
  "paths": {
    "/v1/x402/health/probe": {
      "post": {
        "operationId": "probeX402PaidPathHealth",
        "summary": "Check an unpaid x402 challenge",
        "description": "Check whether one public paid route returns a parseable 402 challenge without signing or paying.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["target"],
                "properties": {
                  "target": {
                    "type": "string",
                    "format": "uri"
                  },
                  "method": {
                    "type": "string",
                    "enum": ["GET", "HEAD", "OPTIONS"]
                  }
                }
              },
              "example": {
                "target": "https://example.com",
                "method": "GET"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid health report"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        },
        "x-x402-price": {
          "amount": "0.50",
          "asset": "USDC"
        }
      }
    },
    "/v1/x402/agent-tools/readiness": {
      "post": {
        "operationId": "checkAgentToolReadiness",
        "summary": "Check agent-tool routeability and listing readiness",
        "description": "Combine public metadata and discovery checks into a claim-bounded readiness result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["target"],
                "properties": {
                  "target": {
                    "type": "string",
                    "format": "uri"
                  },
                  "tier": {
                    "type": "string",
                    "enum": ["quick", "deep", "report"]
                  }
                }
              },
              "example": {
                "target": "https://example.com",
                "tier": "quick"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid readiness result"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        },
        "x-x402-price": {
          "amount": "1.00",
          "asset": "USDC"
        }
      }
    },
    "/v1/x402/launch-pack": {
      "post": {
        "operationId": "generateX402LaunchPack",
        "summary": "Generate marketplace launch artifacts",
        "description": "Create buyer-safe listing copy, a checklist, FAQ, and claim boundaries from public readiness evidence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["target"],
                "properties": {
                  "target": {
                    "type": "string",
                    "format": "uri"
                  },
                  "tier": {
                    "type": "string",
                    "enum": ["single", "service", "premium"]
                  }
                }
              },
              "example": {
                "target": "https://example.com",
                "tier": "single"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid launch-pack result"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        },
        "x-x402-price": {
          "amount": "9.00",
          "asset": "USDC"
        }
      }
    },
    "/v1/receipts/check": {
      "post": {
        "operationId": "generateTrustReceipt",
        "summary": "Generate a deterministic trust receipt",
        "description": "Create a claim-bounded receipt for caller-supplied request and result evidence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "request": {
                  "method": "GET",
                  "path": "/example"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid deterministic receipt"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          }
        },
        "x-x402-price": {
          "amount": "0.05",
          "asset": "USDC"
        }
      }
    }
  },
  "components": {
    "responses": {
      "PaymentRequired": {
        "description": "x402 payment required"
      }
    }
  }
}
