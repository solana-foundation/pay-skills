                      "GET",
                      "HEAD",
                      "OPTIONS"
                    ],
                    "type": "string"
                  },
                  "paid_path": {
                    "format": "uri",
                    "type": "string"
                  },
                  "primary_use_case": {
                    "type": "string"
                  },
                  "product_name": {
                    "type": "string"
                  },
                  "target": {
                    "format": "uri",
                    "type": "string"
                  },
                  "tier": {
                    "default": "single",
                    "enum": [
                      "single",
                      "service",
                      "premium"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "target"
                ],
                "type": "object"
