    "/conflict-check": {
      "post": {
        "summary": "Process conflict-check request and return structured result data",
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              },
              "example": {
                "input": "hello world"
              }
            }
          }
        }
      }
    },
