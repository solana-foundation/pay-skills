  "paths": {
    "/reverse": {
      "post": {
        "summary": "Reverse character order of text string",
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "string, input to reverse"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "operationId": "compute_post_reverse",
        "tags": [
          "compute"
        ]
      }
    },
