          },
          "url": {
            "type": "string",
            "description": "Target URL"
          },
          "value": {
            "type": "string",
            "description": "Value to process"
          },
          "from": {
            "type": "string",
            "description": "Source format or language"
          },
          "to": {
            "type": "string",
            "description": "Target format or language"
          },
          "query": {
            "type": "string",
            "description": "Search or filter query"
          },
          "domain": {
            "type": "string",
            "description": "Domain name"
          },
          "wallet": {
            "type": "string",
            "description": "Wallet address (0x...)"
          },
          "token": {
            "type": "string",
            "description": "Token symbol or address"
          },
          "amount": {
            "type": "number",
            "description": "Numeric amount"
          },
          "code": {
            "type": "string",
            "description": "Code or script to execute"
          },
          "language": {
            "type": "string",
            "description": "Target language"
          },
          "format": {
            "type": "string",
            "description": "Output format"
          },
          "options": {
            "type": "object",
            "description": "Additional options"
