  "paths": {
    "/check": {
      "post": {
        "summary": "Run eligibility check and return pass or fail result",
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "string, URL to check"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "operationId": "url-intel_post_check",
        "tags": [
          "url-intel"
        ]
      }
    },
