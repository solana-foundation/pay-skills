    {
      "url": "https://x402-price-api-production.up.railway.app"
    }
  ],
  "paths": {
    "/price": {
      "get": {
        "summary": "Get real-time crypto token price and 24h market data",
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "parameters": [
          {
            "name": "coin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "string, CoinGecko coin id, default solana"
          }
        ],
        "operationId": "price_get_price",
        "tags": [
          "price"
        ]
      },
      "post": {
        "summary": "POST /price",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "coin": {
                    "type": "string",
                    "description": "string, CoinGecko coin id, default solana"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "operationId": "price_post_price",
        "tags": [
          "price"
        ]
      }
    },
