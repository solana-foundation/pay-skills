    "title": "x402-price-api",
    "version": "1.0.0",
    "description": "MyTollBooth — x402-price-api. x402 v2 protocol, USDC on Base.",
    "contact": {
      "name": "MyTollBooth",
      "email": "support@mytollbooth.com",
      "url": "https://x402-api-production-bd43.up.railway.app"
