    "/price": {
      "get": {
        "summary": "Get real-time crypto token price and 24h market data",
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "parameters": [
          {
            "name": "wallet",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Wallet address"
          },
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Token symbol"
          },
          {
            "name": "domain",
            "in": "query",
            "required": false,
