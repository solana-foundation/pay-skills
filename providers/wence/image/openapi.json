  "paths": {
    "/resize": {
      "post": {
        "summary": "Resize image to specified dimensions and output format",
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "description": "string, base64 or URL of image"
                  },
                  "width": {
                    "type": "integer",
                    "description": "integer, target width"
                  },
                  "height": {
                    "type": "integer",
                    "description": "integer, target height"
                  }
                },
                "required": [
                  "image"
                ]
              }
            }
          }
        },
        "operationId": "image_post_resize",
        "tags": [
          "image"
        ]
      }
    },
