                  },
                  "format": {
                    "type": "string",
                    "description": "string, target format (png,jpg,webp)"
                  }
                },
                "required": [
                  "image",
                  "format"
                ]
              }
            }
          }
        },
        "operationId": "image_post_convert",
        "tags": [
          "image"
        ]
