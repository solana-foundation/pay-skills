    "/chat": {
      "post": {
        "summary": "Process chat request and return structured result data",
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "string, user prompt"
                  },
                  "model": {
                    "type": "string",
                    "description": "string, model id, default claude-sonnet"
                  }
                },
                "required": [
                  "prompt"
                ]
              }
            }
          }
        }
      }
    },
