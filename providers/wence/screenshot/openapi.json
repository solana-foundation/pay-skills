        "summary": "Capture screenshot of URL and return PNG image data",
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              },
              "example": {
                "input": "hello world"
              }
            }
          }
        },
        "operationId": "screenshot_post_screenshot",
