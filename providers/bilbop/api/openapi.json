                    "decimals": 6,
                    "supply": "9000000000.000000",
                    "mintAuthority": "BJE5MMbqXjVwjAF7oxwPYXnTXDyspzZyt4vwenNw5ruG",
                    "freezeAuthority": "7dGbd2QZcCKcTndnHcTL8q7SMVXAkp688NTQYwrRCrar",
                    "tokenProgram": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA",
                    "initialized": true,
                    "sources": [
                      "bentlawgic-token-basic"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body (paid requests are validated before settlement)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required. x402 challenge in the JSON body and the base64 PAYMENT-REQUIRED header. Retry with an X-PAYMENT (v1) or PAYMENT-SIGNATURE (v2) header.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 PaymentRequired object (same as the body)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Origin temporarily unavailable (tunnel rotating); retry after Retry-After seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/brand-feedback": {
      "post": {
        "operationId": "brandFeedback",
        "summary": "Fetch real human feedback about a brand or product",
        "description": "Routes a short question about a brand or product to real human respondents via the WURK human-task marketplace and returns their replies with a sentiment aggregate. Replies can take minutes. 0.50 USDC per call.",
        "tags": [
          "Humans"
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.50"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "brand": {
                    "type": "string",
                    "description": "Brand or product name",
                    "minLength": 1,
                    "example": "Acme"
                  },
                  "question": {
                    "type": "string",
                    "description": "Question to ask human respondents",
                    "minLength": 1,
                    "example": "Would you buy again?"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 5,
                    "description": "Number of human respondents (default 5)",
                    "example": 1
                  }
                },
                "required": [
                  "brand",
                  "question"
                ],
                "example": {
                  "brand": "Acme",
                  "question": "Would you buy again?",
                  "n": 1
                }
              },
              "example": {
                "question": "Is bilbop a useful API for agents?",
                "brand": "bilbop"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Human replies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "brand": {
                      "type": "string"
                    },
                    "question": {
                      "type": "string"
                    },
                    "n": {
                      "type": "integer"
                    },
                    "responses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "sentiment": {
                            "type": "string",
                            "enum": [
                              "positive",
                              "neutral",
                              "negative"
                            ]
                          }
                        }
                      }
                    },
                    "aggregate": {
                      "type": "object",
                      "properties": {
                        "positive": {
                          "type": "integer"
                        },
                        "neutral": {
                          "type": "integer"
                        },
                        "negative": {
                          "type": "integer"
                        },
                        "summary": {
                          "type": "string"
                        }
                      }
                    },
                    "mock": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "brand",
                    "responses"
                  ],
                  "example": {
                    "brand": "Acme",
                    "question": "Would you buy again?",
                    "n": 1,
                    "responses": [
                      {
                        "text": "Yes, the quality was good for the price.",
                        "sentiment": "positive"
                      }
                    ],
                    "aggregate": {
                      "positive": 1,
                      "neutral": 0,
                      "negative": 0,
                      "summary": "1/1 positive."
                    },
                    "mock": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body (paid requests are validated before settlement)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required. x402 challenge in the JSON body and the base64 PAYMENT-REQUIRED header. Retry with an X-PAYMENT (v1) or PAYMENT-SIGNATURE (v2) header.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 PaymentRequired object (same as the body)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Origin temporarily unavailable (tunnel rotating); retry after Retry-After seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tts": {
      "post": {
        "operationId": "textToSpeech",
        "summary": "Generate speech audio from text with self-hosted Piper TTS",
        "description": "Turn up to 2500 characters of English text into a natural voice WAV file using self-hosted open-source Piper voices. Response body is raw audio/wav bytes (mono, 22.05 kHz). 0.025 USDC per call.",
        "tags": [
          "Audio"
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.025"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Text to speak (max 2500 chars)",
                    "minLength": 1,
                    "maxLength": 2500,
                    "example": "Hello from Piper"
                  },
                  "voice_id": {
                    "type": "string",
                    "description": "Optional Piper voice id (GET /piper/v1/voices)",
                    "default": "en_US-lessac-medium",
                    "example": "en_US-lessac-medium"
                  }
                },
                "required": [
                  "text"
                ],
                "example": {
                  "text": "Hello from Piper",
                  "voice_id": "en_US-lessac-medium"
                }
              },
              "example": {
                "text": "Hello from bilbop"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Raw WAV audio bytes",
            "headers": {
              "X-TTS-Voice-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "X-TTS-Format": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "contentMediaType": "audio/wav"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body (paid requests are validated before settlement)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required. x402 challenge in the JSON body and the base64 PAYMENT-REQUIRED header. Retry with an X-PAYMENT (v1) or PAYMENT-SIGNATURE (v2) header.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 PaymentRequired object (same as the body)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Origin temporarily unavailable (tunnel rotating); retry after Retry-After seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PaymentRequired": {
        "type": "object",
        "description": "x402 PaymentRequired challenge",
        "properties": {
          "x402Version": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "example": "exact"
                },
                "network": {
                  "type": "string",
                  "example": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
                },
                "amount": {
                  "type": "string",
                  "description": "Token atomic units (USDC 6 decimals)"
                },
                "maxAmountRequired": {
                  "type": "string",
                  "description": "Token atomic units (legacy v1 field)"
                },
                "resource": {
                  "type": "string",
                  "format": "uri"
                },
                "description": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "payTo": {
                  "type": "string"
                },
                "maxTimeoutSeconds": {
