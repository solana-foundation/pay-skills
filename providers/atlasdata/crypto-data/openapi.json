  "info": {
    "contact": {
      "email": "atlasdataeb5a87@fldubai.com"
    },
    "description": "Pay-per-call x402 API accepting USDC on Solana mainnet and EVM chains.",
    "title": "AtlasData Crypto Data",
    "version": "0.1.0",
    "x-guidance": "All /api/* endpoints are x402-paid in USDC on Base mainnet (eip155:8453). GET requests only. Pay, then retry with the payment signature to receive data. /api/report/x402-monetization returns a full markdown report."
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/btc/fees": {
      "get": {
        "description": "Bitcoin mempool fee estimates in sat/vB.",
        "operationId": "btc_fees_api_btc_fees_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "402": {
            "description": "Payment required (x402, USDC on Base)"
          }
        },
        "summary": "Get current Bitcoin transaction fee rate estimates.",
        "x-payment-info": {
          "price": {
            "amount": "0.002",
            "currency": "USD",
            "mode": "fixed"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
