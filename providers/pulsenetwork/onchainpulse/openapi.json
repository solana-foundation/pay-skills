        "parameters": [
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "stablecoin",
                "tbill",
                "compare",
                "risk"
              ],
              "default": "compare"
            }
          },
          {
            "name": "risk",
            "in": "query",
            "description": "Risk tolerance for recommendations framing",
            "schema": {
              "type": "string",
              "enum": [
                "low",
