    "/api/memecoin": {
      "get": {
        "summary": "Check a Solana memecoin for honeypot and rug risk",
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "x402 payment signature header. Omit to receive a 402 with payment requirements (USDC on Solana mainnet or Base), then sign and retry."
          },
          {
            "name": "mint",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263",
            "description": "SPL token mint address (base58)"
          }
        ],
        "responses": {
          "200": {
            "description": "Deterministic CLEAR/CAUTION/AVOID verdict + is_safe + risk_score, with safety (mint/freeze authority, LP lock, rug score, danger risks), holder concentration, and live momentum (liquidity, buy/sell flow, age). Fuses RugCheck + Solana RPC + DexScreener."
          },
          "402": {
            "description": "$0.015"
          }
        },
        "x-price-usd": 0.015,
        "x-payment": "x402",
        "x-agent-use-case": "An autonomous Solana trading agent calls this before buying any memecoin to get an instant rug/honeypot + momentum read as one decisive verdict."
      }
    },
    "/api/evmtoken": {
      "get": {
        "summary": "Check an EVM token for honeypot and rug risk",
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "x402 payment signature header. Omit to receive a 402 with payment requirements (USDC on Solana mainnet or Base), then sign and retry."
          },
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "0x532f27101965dd16442E59d40670FaF5eBB142E4",
            "description": "ERC-20 token contract address (0x + 40 hex)"
          },
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "base",
                "ethereum",
                "bsc",
                "arbitrum",
                "polygon",
                "optimism",
                "avalanche"
              ],
              "default": "base"
            },
            "example": "base",
            "description": "EVM chain (default base)"
          }
        ],
        "responses": {
          "200": {
            "description": "Deterministic CLEAR/CAUTION/AVOID verdict + is_safe + risk_score, with safety (honeypot/sell-sim, buy/sell tax, open-source, proxy, mint, ownership renounced, pausable, blacklist, LP lock/burn \u2014 owner-gated risks marked dormant when renounced), holder concentration, and live momentum. Fuses GoPlus Token Security + DexScreener."
          },
          "402": {
            "description": "$0.015"
          }
        },
        "x-price-usd": 0.015,
        "x-payment": "x402",
        "x-agent-use-case": "An autonomous Base/EVM trading agent calls this before buying any token to get an instant honeypot/rug + momentum read as one decisive verdict, across 7 EVM chains."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "x402 payment signature. USDC on Base mainnet. See /.well-known/agent.json for payment details."
      }
    }
  }
}