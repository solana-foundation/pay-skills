{
  "openapi": "3.1.0",
  "info": {
    "title": "CryptoPulse API",
    "description": "Global cryptocurrency intelligence API. 10 endpoints: DeFi yield farming across Ethereum/Base/Arbitrum/Solana (DeFiLlama live TVL + APY), personalized strategy builder, crypto security framework (with Ledger/Trezor hardware wallet links), threat intelligence, exchange comparison (with Coinbase/Gemini/Kraken/Binance exchange affiliate links, experience-aware), crypto tax guidance for 20+ countries (with Koinly/CoinLedger tax software links), beginner onboarding (exchange links), spending guide, crypto-friendly banking, and merchant payment setup. Powered by CoinGecko, DeFiLlama, Fear & Greed Index, and Tavily. All require x402 micropayment (USDC on Base).",
    "version": "1.2.0",
    "contact": {
      "url": "https://cryptopulse.vercel.app"
    }
  },
  "servers": [
    {
      "url": "https://cryptopulse-xi-five.vercel.app",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "x402 payment signature. Send a GET request without this header to receive a 402 with payment requirements. Sign the payment and retry with the PAYMENT-SIGNATURE header.",
        "required": true
      }
    }
  },
  "security": [
    {
      "x402": []
    }
  ],
  "paths": {
    "/api/yield": {
      "get": {
        "summary": "Compare DeFi yield and APY across chains",
        "description": "Real-time DeFi yield opportunities ranked by risk-adjusted return across protocols and chains. Includes Berachain PoL spotlight, protocol TVL data, and entry steps.",
        "operationId": "yield",
        "parameters": [
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "all"
            },
            "description": "Filter by chain: ethereum, base, arbitrum, berachain, solana, or all"
          },
          {
            "name": "risk",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "conservative",
                "moderate",
                "aggressive"
              ],
              "default": "moderate"
            },
            "description": "Risk profile filter"
          }
        ],
        "responses": {
          "200": {
            "description": "DeFi yield opportunities with rankings and entry steps"
          },
          "402": {
            "description": "Payment required. Respond with PAYMENT-SIGNATURE to proceed."
          }
        },
        "security": [
          {
            "x402": []
          }
        ],
        "x-agent-use-case": "on-demand",
        "x-price-usd": 0.1,
        "x-agent-chaining": "Pair with /api/security to ensure self-custody setup before depositing into protocols"
      }
    },
    "/api/strategy": {
      "get": {
        "summary": "Generate a personalized DeFi allocation strategy",
        "description": "Custom DeFi allocation plan with step-by-step entry paths for your capital, risk tolerance, and goals. Agent-executable output.",
        "operationId": "strategy",
        "parameters": [
          {
            "name": "capital",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 10000
            },
            "description": "Capital in USD"
          },
          {
            "name": "risk",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "conservative",
                "moderate",
                "aggressive"
              ],
              "default": "moderate"
            }
          },
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "all"
            },
            "description": "chain parameter"
          },
          {
            "name": "goal",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "yield",
                "growth",
                "stable",
                "privacy"
              ],
              "default": "yield"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 180
            },
            "description": "Investment timeframe in days"
          }
        ],
        "responses": {
          "200": {
            "description": "Personalized DeFi strategy with allocations and entry/exit paths"
          },
          "402": {
            "description": "Payment required."
          }
        },
        "security": [
          {
            "x402": []
          }
        ],
        "x-agent-use-case": "on-demand",
        "x-price-usd": 0.2,
        "x-agent-chaining": "Follow with /api/yield for specific DeFi pools matching the recommended strategy"
      }
    },
    "/api/security": {
      "get": {
        "summary": "Pre-trade token/address risk scan plus self-custody security framework",
        "description": "Two capabilities in one call. (1) Live on-chain risk scan via GoPlus when a token contract and/or wallet address is supplied: honeypot, rugpull, mint/tax traps, and sanctioned/phishing/mixer address screening across ethereum, bsc, base, polygon, arbitrum, optimism, and avalanche. (2) Self-custody security framework: hardware wallet selection, seed phrase storage, multi-sig setup, and approval hygiene tailored to holdings value. Pass token/address/chain for the pre-trade scan; pass value_tier/setup for the custody framework; pass both for a combined verdict.",
        "operationId": "security",
        "parameters": [
          {
            "name": "value_tier",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "under1k",
                "1k-10k",
                "10k-100k",
                "over100k"
              ],
              "default": "1k-10k"
            },
            "description": "Holdings value bracket; scales the custody framework."
          },
          {
            "name": "setup",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "exchange-only",
                "software-wallet",
                "hardware-wallet",
                "multisig",
                "institutional"
              ],
              "default": "exchange-only"
            },
            "description": "Current custody setup, graded for upgrades."
          },
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional token contract address to risk-scan for honeypot/tax/mint traps (GoPlus)."
          },
          {
            "name": "address",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional wallet address to screen for sanctions/phishing/mixer exposure (GoPlus)."
          },
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ethereum",
                "bsc",
                "base",
                "polygon",
                "arbitrum",
                "optimism",
                "avalanche"
              ],
              "default": "ethereum"
            },
            "description": "Chain for the token/address scan."
          }
        ],
        "responses": {
          "200": {
            "description": "Security framework with prioritized action list"
          },
          "402": {
            "description": "Payment required."
          }
        },
        "security": [
          {
            "x402": []
          }
        ],
        "x-agent-use-case": "on-demand",
        "x-price-usd": 0.1,
        "x-agent-chaining": "Response includes Ledger/Trezor hardware wallet links for self-custody"
      }
    },
