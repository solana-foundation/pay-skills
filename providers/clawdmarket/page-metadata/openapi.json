{
  "openapi": "3.1.0",
  "info": {
    "title": "ClawdMarket Web Page Metadata",
    "version": "2.0.0",
    "description": "Platform-run x402 pay-per-call endpoint on clawdmkt.com. One payment (USDC on Solana or Base) buys one fetch of one public web page, returned as JSON metadata."
  },
  "servers": [
    {
      "url": "https://www.clawdmkt.com"
    }
  ],
  "paths": {
    "/api/x402/page-metadata": {
      "post": {
        "operationId": "x402_page_metadata",
        "summary": "Fetch web page metadata as JSON, $0.01 USDC per call",
        "description": "Fetch one public web page and return its title, description, canonical URL, language, headings, Open Graph tags, link counts and word count as JSON. Reads at most 2 MB; private and local addresses are refused. Charged only when the fetch succeeds. Send the JSON body without PAYMENT-SIGNATURE to receive HTTP 402 with the PAYMENT-REQUIRED header (x402 v2, exact: USDC on Base by EIP-3009, and USDC on Solana when a second accepts entry is offered). Sign one of those requirements and repeat the same request with PAYMENT-SIGNATURE. The payment is settled only after the call succeeds; one authorization buys one call.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "One public http(s) URL"
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              },
              "example": {
                "url": "https://example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The page metadata in `result` and the payment in `payment`. A PAYMENT-RESPONSE header (x402 v2) is set when the payment settled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "service",
                    "result",
                    "payment"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "service": {
                      "type": "string",
                      "const": "page-metadata"
                    },
                    "result": {
                      "type": "object",
                      "description": "Metadata of the fetched page. For a non-HTML response the metadata fields are empty and only the URL, status and content type are filled.",
                      "required": [
                        "requested_url",
                        "final_url",
                        "http_status",
                        "fetched_at"
                      ],
                      "properties": {
                        "requested_url": {
                          "type": "string",
                          "description": "The URL as sent, normalized."
                        },
                        "final_url": {
                          "type": "string",
                          "description": "The URL after following redirects. Cache results by this value."
                        },
                        "redirects": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "The URL of each redirect target, in order (at most 5); empty when there were none."
                        },
                        "http_status": {
                          "type": "integer",
                          "description": "HTTP status of the final response."
                        },
                        "content_type": {
                          "type": "string",
                          "description": "Content-Type of the final response."
                        },
                        "title": {
                          "type": "string",
                          "description": "The <title> text; empty if absent."
                        },
                        "description": {
                          "type": "string",
                          "description": "The meta description; empty if absent."
                        },
                        "canonical_url": {
                          "type": "string",
                          "description": "The rel=canonical URL; empty if absent."
                        },
                        "language": {
                          "type": "string",
                          "description": "The <html lang> value; empty if absent."
                        },
                        "h1": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Text of each H1 heading."
                        },
                        "h2": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Text of each H2 heading."
                        },
                        "open_graph": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "Open Graph tags keyed by property, for example og:title."
                        },
                        "links": {
                          "type": "object",
                          "description": "Link counts on the page.",
                          "properties": {
                            "total": {
                              "type": "integer",
                              "description": "All links."
                            },
                            "internal": {
                              "type": "integer",
                              "description": "Links to the same origin."
                            },
                            "external": {
                              "type": "integer",
                              "description": "Links to other origins."
                            }
                          }
                        },
                        "word_count": {
                          "type": "integer",
                          "description": "Words of visible text."
                        },
                        "truncated": {
                          "type": "boolean",
                          "description": "True when the page exceeded 2 MB and only the first 2 MB was read."
                        },
                        "fetched_at": {
                          "type": "string",
                          "description": "When the page was fetched (ISO 8601)."
                        }
                      }
                    },
                    "payment": {
                      "type": "object",
                      "description": "How this call was paid.",
                      "properties": {
                        "rail": {
                          "type": "string",
                          "description": "Always x402."
                        },
                        "charged": {
                          "oneOf": [
                            {
                              "type": "boolean",
                              "const": true
                            },
                            {
                              "type": "string",
                              "const": "unknown"
                            }
                          ],
                          "description": "true when settlement confirmed; \"unknown\" when the facilitator did not answer in time (the result is still returned)."
                        },
                        "amount_usd": {
                          "type": "string",
                          "description": "Price in USD."
                        },
                        "amount_units": {
                          "type": "string",
                          "description": "Price in USDC base units (6 decimals)."
                        },
                        "currency": {
                          "type": "string",
                          "description": "Always USDC."
                        },
                        "network": {
                          "type": "string",
                          "description": "CAIP-2 network the payment used: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp or eip155:8453."
                        },
                        "payer": {
                          "type": "string",
                          "description": "Paying wallet address."
                        },
                        "transaction": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Settlement transaction signature or hash; null if not yet known."
                        },
                        "receipt_id": {
                          "type": "string",
                          "description": "ClawdMarket receipt ID for this call."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "service": "page-metadata",
                  "result": {
                    "requested_url": "https://example.com/",
                    "final_url": "https://example.com/",
                    "redirects": [],
                    "http_status": 200,
                    "content_type": "text/html; charset=utf-8",
                    "title": "Example Domain",
                    "description": "",
                    "canonical_url": "",
                    "language": "en",
                    "h1": [
                      "Example Domain"
                    ],
                    "h2": [],
                    "open_graph": {},
                    "links": {
                      "total": 1,
                      "internal": 0,
                      "external": 1
                    },
                    "word_count": 25,
                    "truncated": false,
                    "fetched_at": "2026-11-14T00:00:00.000Z"
                  },
                  "payment": {
                    "rail": "x402",
                    "charged": true,
                    "amount_usd": "0.01",
                    "amount_units": "10000",
                    "currency": "USDC",
                    "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
                    "payer": "<payer wallet address>",
                    "transaction": "<settlement transaction signature>",
                    "receipt_id": "<receipt id>"
                  }
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT or a malformed payment; nothing charged"
          },
          "402": {
            "description": "Payment required (requirements in the body and PAYMENT-REQUIRED header), payment rejected, or X402_SETTLEMENT_FAILED"
          },
          "409": {
            "description": "X402_REQUIREMENTS_MISMATCH or X402_AUTHORIZATION_ALREADY_USED"
          },
          "422": {
            "description": "The call failed (for example FETCH_FAILED or URL_NOT_PUBLIC); nothing charged"
          },
          "429": {
            "description": "RATE_LIMITED; nothing charged"
          },
          "503": {
            "description": "X402_PAY_PER_CALL_DISABLED, X402_UNAVAILABLE or new payments paused; nothing charged"
          }
        }
      }
    }
  }
}
