{
  "openapi": "3.1.0",
  "info": {
    "title": "SOLTRACER Catalyst Tracker",
    "version": "v1",
    "description": "SOLTRACER Catalyst feed: the newest three curated institutional Solana catalysts (ETFs, banks, payments, asset managers, tokenization), each with a SOLTRACER adoption level (0-5) and the SOL price reaction 1 and 3 days after the move. Paid per call in USDC on Solana mainnet over MPP.",
    "contact": {
      "name": "SOLTRACER",
      "url": "https://www.soltracer.xyz"
    }
  },
  "servers": [
    {
      "url": "https://soltracer-catalyst-feed.revernetworks-pbn.workers.dev"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check feed health, payment config and data freshness",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/catalysts/latest": {
      "get": {
        "summary": "Fetch the newest 3 institutional Solana catalysts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "max records to return (1-3)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            }
          }
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.001"
          },
          "protocols": [
            {
              "mpp": {
                "method": "solana",
                "intent": "charge",
                "network": "solana:mainnet",
                "currency": "USDC",
                "amount": "1000",
                "recipient": "5A7YfjySJV1YnxbqKeVhKAeNBNyQGxeBzsxLGrccXZwX",
                "mint": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
              }
            }
          ],
          "pricingMode": "fixed"
        },
        "responses": {
          "200": {
            "description": "catalysts"
          },
          "402": {
            "description": "Payment Required (MPP charge, 0.001 USDC on Solana mainnet; the buyer pays the network fee)"
          }
        }
      }
    },
    "/catalysts": {
      "get": {
        "summary": "Search the newest 3 catalysts by date, type, level or entity",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "earliest catalyst date, YYYY-MM-DD inclusive",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "latest catalyst date, YYYY-MM-DD inclusive",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "comma list of policy|watching|testing|building|holding|running or L0-L5",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_level",
            "in": "query",
            "description": "minimum SOLTRACER level, 0 (policy) to 5 (running)",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          },
          {
            "name": "entity",
            "in": "query",
            "description": "case-insensitive substring of entity",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "max records to return (1-3)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            }
          }
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.001"
          },
          "protocols": [
            {
              "mpp": {
                "method": "solana",
                "intent": "charge",
                "network": "solana:mainnet",
                "currency": "USDC",
                "amount": "1000",
                "recipient": "5A7YfjySJV1YnxbqKeVhKAeNBNyQGxeBzsxLGrccXZwX",
                "mint": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
              }
            }
          ],
          "pricingMode": "fixed"
        },
        "responses": {
          "200": {
            "description": "catalysts"
          },
          "400": {
            "description": "bad query (not charged)"
          },
          "402": {
            "description": "Payment Required (MPP charge, 0.001 USDC on Solana mainnet; the buyer pays the network fee)"
          }
        }
      }
    },
    "/catalysts/{id}": {
      "get": {
        "summary": "Fetch one Solana catalyst record by its stable id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "stable catalyst id from a list response",
            "schema": {
              "type": "string"
            },
            "example": "2026-11-13-circle-d0fa41cee8"
          }
        ],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.001"
          },
          "protocols": [
            {
              "mpp": {
                "method": "solana",
                "intent": "charge",
                "network": "solana:mainnet",
                "currency": "USDC",
                "amount": "1000",
                "recipient": "5A7YfjySJV1YnxbqKeVhKAeNBNyQGxeBzsxLGrccXZwX",
                "mint": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
              }
            }
          ],
          "pricingMode": "fixed"
        },
        "responses": {
          "200": {
            "description": "catalyst"
          },
          "402": {
            "description": "Payment Required (MPP charge, 0.001 USDC on Solana mainnet; the buyer pays the network fee)"
          },
          "404": {
            "description": "unknown id (not charged)"
          }
        }
      }
    }
  }
}
