                            "top": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "owner",
                                  "pct",
                                  "kind",
                                  "label"
                                ],
                                "properties": {
                                  "owner": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "tokenAccount": {
                                    "type": "string",
                                    "description": "Set when the owner couldn't be read."
                                  },
                                  "pct": {
                                    "type": "number"
                                  },
                                  "kind": {
                                    "type": "string",
                                    "enum": [
                                      "wallet",
                                      "program",
                                      "burn",
                                      "unknown"
                                    ]
                                  },
                                  "label": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        },
                        "launch": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "description": "Launchpad stage; null when the token didn't launch on a tracked launchpad.",
                          "required": [
                            "platform",
                            "stage"
                          ],
                          "properties": {
                            "platform": {
                              "type": "string"
                            },
                            "stage": {
                              "type": "string",
                              "enum": [
                                "bonding-curve",
                                "graduated"
                              ]
                            }
                          }
                        },
                        "age": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "description": "When exact is true, createdAt and days are set; otherwise atLeastDays and note are. Null when age couldn't be fetched.",
                          "required": [
                            "exact"
                          ],
                          "properties": {
                            "exact": {
                              "type": "boolean"
                            },
                            "createdAt": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "days": {
                              "type": "number"
                            },
                            "atLeastDays": {
                              "type": "number"
                            },
                            "note": {
                              "type": "string"
                            }
                          }
                        },
                        "limitations": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "disclaimer": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Sample temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
